# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Xcode — user-specific & build artifacts
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
build/
.build-xcode/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Generated Xcode project (regenerate with `xcodegen generate`)
CloakDrop.xcodeproj/

# Packaged app / distribution output (produced by a build; never commit)
*.app/
*.dmg

# Swift Package Manager
.build/
.swiftpm/
Packages/*/.build/
Package.resolved

# Xcode SPM integration caches
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# Vendored ffmpeg — build artifact, produced by scripts/fetch-ffmpeg.sh (README is tracked)
Vendor/ffmpeg/ffmpeg
Vendor/ffmpeg/build/

# Vendored yt-dlp (onedir) — build artifact, produced by scripts/fetch-ytdlp.sh
Vendor/yt-dlp/yt-dlp
Vendor/yt-dlp/_internal/
Vendor/yt-dlp/build/

# Accidental secrets / local config
*.xcconfig.local
secrets.plist

# Signing certificates & provisioning profiles (Developer ID / notarization) — never commit
*.p12
*.cer
*.mobileprovision
*.provisionprofile

# CloakDrop runtime artifacts (should never be committed)
*.cloakpart
*.cloakparts/
