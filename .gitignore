# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Xcode — user-specific & build artifacts
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
build/
.build-xcode/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Generated Xcode project (regenerate with `xcodegen generate`)
CloakDrop.xcodeproj/

# Packaged app / distribution output (produced by a build; never commit).
# Installers are published as GitHub Release assets — the DMG bytes never enter git.
*.app/
*.dmg

# Swift Package Manager
.build/
.swiftpm/
apps/macos/Packages/*/.build/
Package.resolved
# Keep the app's headless package reproducible while ignoring generated Xcode lockfiles.
!apps/macos/Packages/DownloaderCore/Package.resolved

# Xcode SPM integration caches
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# Vendored ffmpeg — build artifact, produced by scripts/fetch-ffmpeg.sh (README is tracked)
apps/macos/Vendor/ffmpeg/ffmpeg
apps/macos/Vendor/ffmpeg/build/

# Vendored yt-dlp (onedir) — build artifact, produced by scripts/fetch-ytdlp.sh
apps/macos/Vendor/yt-dlp/yt-dlp
apps/macos/Vendor/yt-dlp/_internal/
apps/macos/Vendor/yt-dlp/build/

# Monorepo hygiene — the app now lives under apps/macos/. These root-anchored rules guard
# against stray, pre-restructure leftovers at the repo ROOT only (they never affect the real
# apps/macos/Packages source or apps/macos/Vendor binaries, which are handled above). The stale
# root dirs themselves (Vendor/, Packages/, build/, .build-xcode/, CloakDrop.xcodeproj/) are safe
# to delete — they are duplicates of the apps/macos/ tree.
/Vendor/
/Packages/

# Accidental secrets / local config
*.xcconfig.local
secrets.plist

# Signing certificates & provisioning profiles (Developer ID / notarization) — never commit
*.p12
*.cer
*.mobileprovision
*.provisionprofile

# CloakDrop runtime artifacts (should never be committed)
*.cdpart
*.cdparts/

# Brand site (apps/site) — Astro / Node / Wrangler build artifacts & caches
apps/site/node_modules/
apps/site/dist/
apps/site/.astro/
apps/site/.wrangler/
apps/site/.dev.vars
npm-debug.log*
.env
.env.*

# Shared brand assets copied into the site from /assets by scripts/sync-assets.mjs.
# /assets is the single source of truth; these are generated (prebuild → sync:assets, so
# Cloudflare regenerates them too) and must NOT be committed — that's the de-duplication.
# Site-specific assets (fonts/, robots.txt) are NOT listed here and stay tracked.
apps/site/public/cloakdrop-mark.svg
apps/site/public/icons/favicon.svg
apps/site/public/icon.png
apps/site/public/favicon.png
apps/site/public/apple-touch-icon.png
apps/site/public/og.png
apps/site/public/hero.webp
apps/site/public/hero.png
