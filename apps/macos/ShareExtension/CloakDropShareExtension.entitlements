<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The share extension runs fully sandboxed, like the app. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- project-release.yml opts into the provisioned App Group. The normal Debug and
         Release configurations remain team-less; their Share inbox is unavailable. -->
</dict>
</plist>
