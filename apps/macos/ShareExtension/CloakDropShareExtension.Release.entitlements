<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release entitlements = the Debug set PLUS the App Group (which needs a development team).
	     Keep in sync with CloakDropShareExtension.entitlements and CloakDrop.Release.entitlements. -->
	<!-- The share extension runs fully sandboxed, like the app. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Shared container with the app: the shared URL crosses the boundary here (never over the
	     network — the extension has no network access). Must match CloakDrop.Release.entitlements. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.cloakyard.cloakdrop</string>
	</array>
</dict>
</plist>
