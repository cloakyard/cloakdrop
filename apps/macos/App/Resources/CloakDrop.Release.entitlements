<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Provisioned distribution via project-release.yml: sandbox permissions plus App Group
         and Sparkle IPC; library validation remains enabled with a Developer ID identity. -->
	<!-- App Sandbox: CloakDrop runs fully sandboxed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outbound network access, for downloading the URLs the user requests. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Read/write to folders the user explicitly picks as download destinations,
	     persisted via security-scoped bookmarks. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Convenience access to the standard Downloads folder. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- Shared container with the bundled Share extension: captured downloads cross the sandbox
	     boundary here (see CaptureInbox). Must match the Share extension's entitlements. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.cloakyard.cloakdrop</string>
	</array>
    <!-- Sparkle installer status and installation, scoped to this app. -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
    </array>
</dict>
</plist>
