{
  "name": "cloakdrop-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CloakDrop brand site — drop.cloakyard.com",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync:assets": "node ../../scripts/sync-assets.mjs",
    "predev": "npm run sync:assets",
    "dev": "astro dev",
    "prebuild": "npm run sync:assets",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "fast-uri": "3.1.7",
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260908.1": true,
    "fsevents@2.3.3": true
  }
}
