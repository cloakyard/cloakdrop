{
  "name": "cloakdrop-site",
  "version": "1.0.0",
  "private": true,
  "description": "CloakDrop brand site — drop.cloakyard.com",
  "type": "module",
  "scripts": {
    "sync:assets": "node ../../scripts/sync-assets.mjs",
    "predev": "npm run sync:assets",
    "dev": "astro dev",
    "prebuild": "npm run sync:assets",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "npm run build && wrangler dev",
    "design:check": "node ../../scripts/check-air-design.mjs",
    "design:inventory": "node ../../scripts/air-inventory.mjs",
    "design:portability": "node ../../scripts/check-air-portability.mjs",
    "test:air-links": "node ../../scripts/test-air-links.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.155.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.15.0 || >=26.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "fsevents@2.3.3": true
  },
  "packageManager": "npm@12.2.1"
}
