{
  "name": "cloakdrop-site",
  "version": "1.0.0",
  "private": true,
  "description": "CloakDrop brand site — drop.cloakyard.com",
  "type": "module",
  "scripts": {
    "sync:assets": "node ../../scripts/sync-assets.mjs",
    "predev": "npm run sync:assets",
    "dev": "astro dev",
    "prebuild": "npm run sync:assets",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "npm run build && wrangler dev",
    "design:check": "node ../../scripts/check-air-design.mjs",
    "design:inventory": "node ../../scripts/air-inventory.mjs",
    "design:portability": "node ../../scripts/check-air-portability.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.2"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "fsevents@2.3.3": true
  }
}
