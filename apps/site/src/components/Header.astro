---
import { site, nav } from '../data/site';
import Icon from './Icon.astro';
import Brand from './Brand.astro';
---

<header class="header" data-site-header>
  <div class="container bar">
    <Brand size={40} />

    <nav class="nav nav--desktop" aria-label="Primary">
      {nav.map((link) => <a href={link.href} data-nav-link>{link.label}</a>)}
    </nav>

    <div class="actions">
      <a
        class="source-link"
        href={site.repo}
        target="_blank"
        rel="noreferrer"
        aria-label="View CloakDrop source on GitHub"
      >
        <Icon name="github" size={16} />
        <span>Source</span>
      </a>

      <button
        class="menu-toggle"
        type="button"
        popovertarget="mobile-nav"
        aria-label="Open navigation"
      >
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-panel" popover>
    <div class="mobile-head">
      <p>Navigate</p>
      <button
        class="panel-close"
        type="button"
        popovertarget="mobile-nav"
        popovertargetaction="hide"
        aria-label="Close navigation"
      >
        <span aria-hidden="true"></span>
      </button>
    </div>
    <nav aria-label="Mobile navigation">
      {nav.map((link, index) => (
        <a href={link.href} data-nav-link>
          <span>{String(index + 1).padStart(2, '0')}</span>
          {link.label}
        </a>
      ))}
    </nav>
    <p class="mobile-foot">Native macOS · MIT licensed</p>
  </div>

  <div class="scroll-progress" aria-hidden="true"><i data-scroll-progress></i></div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 4.5rem;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    height: 100%;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .nav a {
    position: relative;
    min-height: 2.5rem;
    display: inline-flex;
    align-items: center;
    padding-inline: 0.75rem;
    transition: color 0.18s ease;
  }

  .nav a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--accent-ink);
    opacity: 0;
    transform: translate(-50%, 3px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  .nav a:hover,
  .nav a[aria-current='true'] {
    color: var(--ink);
  }

  .nav a[aria-current='true']::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .source-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--line-2);
    border-radius: 6px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    transition:
      border-color 0.18s ease,
      color 0.18s ease,
      background 0.18s ease;
  }

  .source-link:hover {
    border-color: color-mix(in srgb, var(--ink-4) 38%, var(--line-2));
    color: var(--ink);
    background: var(--surface-2);
  }

  .menu-toggle,
  .panel-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    color: var(--ink-2);
    background: transparent;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }

  .menu-toggle:hover,
  .panel-close:hover {
    color: var(--ink);
    background: var(--surface-2);
  }

  .menu-toggle {
    display: none;
  }

  .menu-toggle span,
  .menu-toggle span::before,
  .panel-close span::before,
  .panel-close span::after {
    display: block;
    width: 18px;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
  }

  .menu-toggle span::before {
    content: '';
    transform: translateY(6px);
  }

  .panel-close span {
    position: relative;
    width: 18px;
    height: 18px;
  }

  .panel-close span::before,
  .panel-close span::after {
    content: '';
    position: absolute;
    top: 8px;
  }

  .panel-close span::before {
    transform: rotate(45deg);
  }

  .panel-close span::after {
    transform: rotate(-45deg);
  }

  .mobile-panel {
    inset: 5rem var(--gutter) auto auto;
    width: min(30rem, calc(100vw - (var(--gutter) * 2)));
    max-width: 30rem;
    margin: 0;
    padding: 0.75rem;
    overscroll-behavior: contain;
    border: 1px solid var(--line-2);
    border-radius: 8px;
    color: var(--ink-2);
    background: var(--surface);
    box-shadow: 0 28px 80px -30px rgba(12, 17, 20, 0.48);
  }

  .mobile-panel::backdrop {
    background: color-mix(in srgb, var(--band) 58%, transparent);
  }

  .mobile-panel:popover-open {
    animation: panel-in 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .mobile-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.15rem 0.15rem 0.65rem 0.65rem;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-4);
  }

  .mobile-panel nav {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .mobile-panel nav a {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: center;
    min-height: 3.5rem;
    padding-inline: 0.65rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 700;
  }

  .mobile-panel nav a span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--accent-ink);
  }

  .mobile-foot {
    padding: 0.85rem 0.65rem 0.15rem;
    color: var(--ink-4);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .scroll-progress {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 1px;
    overflow: hidden;
    pointer-events: none;
  }

  .scroll-progress i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.985);
    }
  }

  @media (max-width: 900px) {
    .bar {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .nav--desktop {
      display: none;
    }

    .actions {
      justify-self: end;
    }

    .source-link {
      min-height: 44px;
      border-radius: var(--radius);
    }

    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 520px) {
    .bar {
      gap: 0.35rem;
    }

    .source-link {
      width: 44px;
      min-height: 44px;
      padding: 0;
    }

    .source-link span {
      display: none;
    }

    .mobile-panel {
      top: 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-panel:popover-open {
      animation: none;
    }
  }
</style>
