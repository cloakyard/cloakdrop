---
import { site, nav } from '../data/site';
import Icon from './Icon.astro';
import Brand from './Brand.astro';
interface Props { linkPrefix?: string; }
const { linkPrefix = '' } = Astro.props;
const href = (anchor: string) => `${linkPrefix}${anchor}`;
---
<header class="site-header frame">
  <Brand />
  <nav class="desktop-nav" aria-label="Primary">
    {nav.map((link) => <a href={href(link.href)} data-nav-link>{link.label}</a>)}
  </nav>
  <a class="desktop-source text-link" href={site.repo}>Source <Icon name="link" size={16} /></a>
  <details class="mobile-nav" data-navigation>
    <summary class="air-button air-button--quiet">Menu <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" /></svg></summary>
    <nav aria-label="Primary">
      {nav.map((link) => <a href={href(link.href)} data-nav-link>{link.label}</a>)}
      <a href={site.repo}>Source <Icon name="link" size={16} /></a>
    </nav>
  </details>
</header>
