---
import { suite, site } from '../data/site';
import Kicker from './Kicker.astro';
import Icon from './Icon.astro';
---

<section id="suite" class="section suite">
  <div class="container">
    <Kicker num={suite.num} label={suite.label} />

    <div class="head">
      <h2>{suite.title}</h2>
      <p class="lead">{suite.lead}</p>
    </div>

    <ul class="list">
      {
        suite.apps.map((app) => (
          <li>
            <a
              class:list={['row', app.self && 'row--self']}
              href={app.href}
              rel="noopener"
            >
              <span class="name">{app.name}</span>
              <span class="desc">{app.desc}</span>
              <span class="tag">
                {app.tag}
                <Icon name="arrow" size={17} stroke={1.8} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="org">
      Explore the whole family on
      <a href={site.suiteOrg} rel="noopener">{suite.org}</a>.
    </p>
  </div>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    margin-top: 1.4rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .head h2 {
    max-width: 12ch;
  }

  .head .lead {
    width: min(360px, 100%);
    flex: none;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-2);
    border-bottom: 1px solid var(--line-2);
  }

  .row {
    display: grid;
    grid-template-columns: 220px 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 0.25rem;
    border-bottom: 1px solid var(--line);
    transition: background 0.16s ease;
  }

  .list li:last-child .row {
    border-bottom: 0;
  }

  .row:hover {
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }

  .name {
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .row--self .name {
    color: var(--accent-ink);
  }

  .desc {
    color: var(--ink-3);
    font-size: 0.9375rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--ink-4);
  }

  .tag :global(svg) {
    color: color-mix(in srgb, var(--ink-4) 70%, transparent);
    transition:
      color 0.16s ease,
      transform 0.16s ease;
  }

  .row:hover .tag :global(svg) {
    color: var(--accent-ink);
    transform: translateX(3px);
  }

  .org {
    margin-top: 1.5rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .org a {
    color: var(--accent-ink);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .head {
      flex-direction: column;
      align-items: flex-start;
    }
    .head .lead {
      width: 100%;
    }
    .row {
      grid-template-columns: 1fr auto;
      gap: 0.4rem 1rem;
    }
    .name {
      grid-column: 1;
      grid-row: 1;
    }
    .desc {
      grid-column: 1;
      grid-row: 2;
    }
    .tag {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
    }
  }
</style>
