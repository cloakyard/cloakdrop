---
import { suite, site } from '../data/site';
import Icon from './Icon.astro';
---

<section id="suite" class="section">
  <div class="container">
    <header class="head">
      <p class="eyebrow">Part of Cloakyard</p>
      <h2>One suite. One design language.</h2>
      <p class="section-lead">
        CloakDrop shares its foundations with the rest of Cloakyard — small, sharp Mac
        tools built on the same native principles, each doing one job well.
      </p>
    </header>

    <ul class="grid">
      {
        suite.map((app) => (
          <li>
            <a
              class={`surface-card app ${app.self ? 'app--self' : ''}`}
              href={app.href}
              rel="noopener"
            >
              <span class="app-name">{app.name}</span>
              <span class="app-blurb">{app.blurb}</span>
              <span class="app-go" aria-hidden="true">
                <Icon name="arrow" size={18} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="org">
      Explore the whole family on
      <a href={site.suiteOrg} rel="noopener">github.com/cloakyard</a>.
    </p>
  </div>
</section>

<style>
  .head {
    max-width: 58ch;
  }

  .grid {
    list-style: none;
    padding: 0;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1rem;
  }

  .app {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    padding: 1.4rem;
  }

  .app--self {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    background:
      radial-gradient(120% 120% at 100% 0%, var(--accent-soft), transparent 60%),
      var(--surface);
  }

  .app-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 630;
    letter-spacing: -0.01em;
  }

  .app--self .app-name {
    color: var(--accent);
  }

  .app-blurb {
    font-size: var(--step--1);
    color: var(--text-secondary);
  }

  .app-go {
    margin-top: auto;
    padding-top: 1rem;
    color: var(--text-tertiary);
    transition: color 0.18s ease;
  }

  .app:hover .app-go {
    color: var(--accent);
  }

  .org {
    margin-top: 2rem;
    color: var(--text-secondary);
    font-size: var(--step--1);
  }

  .org a {
    color: var(--accent);
    font-weight: 560;
  }
</style>
