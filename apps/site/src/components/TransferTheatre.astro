---
import { product } from '../data/site';
import Kicker from './Kicker.astro';
import Icon from './Icon.astro';

const lanes = [64, 49, 86, 58, 72, 91, 53, 78];
---

<section id="product" class="section theatre" data-transfer-theatre>
  <div class="container">
    <header class="intro" data-reveal>
      <Kicker num={product.num} label={product.label} />
      <h2>Small details.<br /><span class="accent">A smoother whole.</span></h2>
    </header>
    <div class="theatre-shell" data-reveal>
      <div class="chapter-switcher" role="tablist" aria-label="Explore CloakDrop">
        {product.stories.map((story, index) => (
          <button id={'tab-' + story.id} type="button" role="tab" disabled
            aria-selected={index === 0 ? 'true' : 'false'} aria-controls={'panel-' + story.id}
            tabindex={index === 0 ? 0 : -1} data-chapter-tab={story.id}>
            <span class="tab-number">{story.n}</span>{story.label}
          </button>
        ))}
      </div>
      {product.stories.map((story) => (
        <article id={'panel-' + story.id} role="tabpanel" tabindex="0"
          aria-labelledby={'tab-' + story.id} data-chapter-panel={story.id} class="chapter-panel">
          <div class="chapter-copy">
            <p class="eyebrow">0{product.stories.indexOf(story) + 1} / {story.label}</p>
            <h3>{story.title}</h3>
            <p>{story.body}</p>
            {story.id === 'transfer' && <p class="fine-print">Try the illustration. No files are downloaded.</p>}
            {story.id === 'capture' && <p class="fine-print">Direct media · HLS · DASH · supported pages<br />Availability depends on the site. DRM media is excluded.</p>}
            {story.id === 'finish' && <a class="text-link" href="#provenance">Made to be inspected <Icon name="arrow" size={17} /></a>}
          </div>
          {story.id === 'transfer' && (
            <div class="transfer-demo" data-simulation data-sim-state="idle">
              <div class="demo-head"><span>EXAMPLE / 8 RANGES</span><Icon name="download" size={18} /></div>
              <ol class="lanes" aria-label="Illustration of eight independently resumable ranges">
                {lanes.map((progress, index) => (
                  <li style={'--hold: ' + progress + '%; --delay: ' + index * 35 + 'ms'}>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <span class="lane-track" aria-hidden="true"><i class="lane-fill"></i><i class="marker"></i></span>
                  </li>
                ))}
              </ol>
              <div class="restore-overlay" aria-hidden="true"><span>↻</span><b>Picking up the pieces.</b><small>Reading saved progress</small></div>
              <p class="phase" data-phase-text role="status" aria-live="polite" aria-atomic="true">Ready when you are.</p>
              <div class="demo-actions">
                <button type="button" class="simulate" data-simulate disabled><span data-simulate-label>Try a relaunch</span><span aria-hidden="true">↻</span></button>
                <button type="button" class="reset" data-reset disabled>Reset</button>
              </div>
            </div>
          )}
          {story.id === 'capture' && (
            <figure class="capture-demo" aria-label="Illustration: a supported page becomes a choice of video, audio and subtitles">
              <div class="page-card">
                <div class="window-top"><span></span><span></span><span></span><small>A supported page</small></div>
                <div class="video-frame"><Icon name="film" size={52} /><span>Find something worth keeping.</span></div>
              </div>
              <div class="format-card">
                <p><Icon name="download" size={18} /> Make it yours</p>
                <dl><div><dt>Video</dt><dd>Choose quality</dd></div><div><dt>Audio</dt><dd>Keep the track</dd></div><div><dt>Subtitles</dt><dd>When available</dd></div></dl>
              </div>
            </figure>
          )}
          {story.id === 'finish' && (
            <figure class="finish-demo" aria-label="File completion sequence: check the available checksum, save the file, and optionally keep a local receipt">
              <p class="demo-head"><span>THE FINISHING TOUCHES</span><Icon name="check" size={18} /></p>
              <ol>
                <li style="--step: 0"><span class="finish-icon"><Icon name="shield" /></span><p><b>Check the bytes.</b><small>Verify an available checksum</small></p></li>
                <li style="--step: 1"><span class="finish-icon"><Icon name="download" /></span><p><b>Save the file.</b><small>Keep existing files intact</small></p></li>
                <li style="--step: 2"><span class="finish-icon"><Icon name="check" /></span><p><b>Keep a record.</b><small>Optional local receipt</small></p></li>
              </ol>
            </figure>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import '../scripts/transferDemo';
</script>

<style>
  .intro { display: grid; gap: 1.4rem; }
  .intro h2 { font-size: clamp(2.4rem, 4vw, 4rem); }
  .theatre-shell { container-type: inline-size; margin-top: 2rem; border: 1px solid var(--line-2); border-radius: var(--radius-xl); overflow: clip; background: var(--surface); }
  .chapter-switcher { display: none; grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: 1px solid var(--line-2); }
  [data-theatre-ready] .chapter-switcher { display: grid; }
  .chapter-switcher button { position: relative; display: flex; gap: 1rem; align-items: center; padding: 1.15rem 1.5rem; min-height: 58px; border: 0; border-right: 1px solid var(--line-2); color: var(--ink-3); background: var(--surface-2); font: 650 1rem var(--font-sans); cursor: pointer; transition: color .2s, background .2s; }
  .chapter-switcher button:last-child { border-right: 0; }
  .chapter-switcher button::after { content: ''; position: absolute; inset: auto 0 -1px; height: 2px; background: var(--accent); transform: scaleX(0); transition: transform .25s ease; }
  .chapter-switcher button[aria-selected='true'] { background: var(--surface); color: var(--ink); }
  .chapter-switcher button[aria-selected='true']::after { transform: scaleX(1); }
  .chapter-switcher button:hover { color: var(--accent-ink); }
  .tab-number { font: 500 .875rem var(--font-mono); color: var(--accent-ink); }
  .chapter-panel { min-width: 0; min-height: 32rem; display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; padding: clamp(1.4rem, 3vw, 3rem); }
  .chapter-panel[hidden] { display: none; }
  [data-theatre-ready] .chapter-panel { animation: chapter-in .35s ease both; }
  .chapter-copy, .transfer-demo, .finish-demo { min-width: 0; }
  .chapter-copy h3 { max-width: 17ch; margin-top: 1rem; font-size: clamp(1.9rem, 3vw, 2.8rem); line-height: 1.05; }
  .chapter-copy > p:not(.eyebrow) { max-width: 44ch; margin-top: 1.1rem; font-size: 1rem; line-height: 1.65; }
  .chapter-copy .fine-print { color: var(--ink-3); font-size: .875rem !important; }
  .text-link { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; margin-top: 1rem; font-weight: 650; color: var(--accent-ink); }
  .transfer-demo, .finish-demo { position: relative; border: 1px solid var(--line-2); border-radius: var(--radius); background: var(--surface-2); padding: 1.25rem; }
  .demo-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; color: var(--accent-ink); font: 550 .875rem var(--font-mono); }
  .lanes { display: grid; gap: .65rem; list-style: none; padding: 0; margin-block: 1.5rem; }
  .lanes li { display: grid; grid-template-columns: 1.4rem minmax(0, 1fr); align-items: center; gap: .75rem; font: 500 .875rem var(--font-mono); color: var(--ink-4); }
  .lane-track { position: relative; height: 5px; border-radius: 8px; background: var(--line-2); }
  .lane-fill { display: block; width: 15%; height: 100%; border-radius: inherit; background: var(--accent); transition: width .75s cubic-bezier(.22, 1, .36, 1) var(--delay); }
  .is-resetting .lane-fill { transition: none; }
  .marker { position: absolute; left: var(--hold); top: -4px; width: 2px; height: 13px; background: var(--ink-3); opacity: 0; transition: opacity .2s; }
  [data-sim-state='running'] .lane-fill, [data-sim-state='paused'] .lane-fill, [data-sim-state='restoring'] .lane-fill { width: var(--hold); }
  [data-sim-state='paused'] .marker, [data-sim-state='restoring'] .marker, [data-sim-state='resuming'] .marker { opacity: 1; }
  [data-sim-state='resuming'] .lane-fill, [data-sim-state='complete'] .lane-fill { width: 100%; }
  [data-sim-state='complete'] .lane-fill { background: var(--positive); }
  .phase { min-height: 2.8rem; color: var(--ink-2); font-size: .875rem; line-height: 1.4; }
  .demo-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: .6rem; }
  .demo-actions button { min-height: 44px; padding: .65rem 1rem; border-radius: var(--radius); font: 600 .875rem var(--font-sans); cursor: pointer; }
  .simulate { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; border: 1px solid var(--accent); background: var(--accent-soft); color: var(--accent-ink); }
  .simulate > span:last-child { font-size: 1.25rem; line-height: 1; }
  .reset { border: 1px solid transparent; background: transparent; color: var(--ink-3); }
  .demo-actions button:disabled { opacity: .5; cursor: default; }
  .restore-overlay { position: absolute; inset: 3.5rem 1rem 8.5rem; display: grid; align-content: center; justify-items: center; gap: .4rem; border-radius: var(--radius); background: var(--surface); opacity: 0; visibility: hidden; transition: opacity .2s, visibility .2s; pointer-events: none; }
  [data-sim-state='restoring'] .restore-overlay { opacity: 1; visibility: visible; }
  .restore-overlay > span { font: 500 2.5rem var(--font-sans); color: var(--accent-ink); }
  .restore-overlay b { color: var(--ink); font-size: 1rem; }
  .restore-overlay small { font-size: .875rem; }
  .capture-demo { position: relative; padding: 1rem 2.5rem 0 0; min-width: 0; }
  .page-card { border: 1px solid var(--line-2); border-radius: var(--radius-lg); overflow: clip; background: var(--surface-2); }
  .window-top { display: flex; align-items: center; gap: 5px; padding: .8rem; border-bottom: 1px solid var(--line-2); }
  .window-top > span { width: 7px; height: 7px; background: var(--ink-4); opacity: .45; border-radius: 50%; }
  .window-top small { margin-left: .6rem; font-size: .875rem; color: var(--ink-3); }
  .video-frame { min-height: 12rem; display: grid; place-content: center; justify-items: center; gap: 1rem; padding: 1rem; color: var(--accent-ink); background: radial-gradient(ellipse at 50% 100%, var(--tint), transparent); }
  .video-frame span { font-size: .875rem; text-align: center; }
  .format-card { position: relative; width: min(100%, 19rem); margin: -1.3rem -2.5rem 0 auto; padding: 1rem 1.25rem; background: var(--surface); border: 1px solid var(--line-2); border-radius: var(--radius-lg); box-shadow: 0 12px 25px -15px #07101450; }
  .format-card > p { display: flex; align-items: center; gap: .6rem; color: var(--ink); font-size: 1rem; font-weight: 650; }
  dl { margin-top: .75rem; }
  dl div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding-block: .5rem; border-top: 1px solid var(--line); font-size: .875rem; }
  dd { color: var(--ink-3); }
  .finish-demo ol { display: grid; padding: 0; list-style: none; margin-top: 1rem; }
  .finish-demo li { position: relative; display: flex; align-items: center; gap: 1rem; padding-block: 1rem; }
  .finish-demo li + li { border-top: 1px solid var(--line-2); }
  .finish-icon { display: grid; place-items: center; flex: none; width: 2.8rem; height: 2.8rem; color: var(--accent-ink); background: var(--accent-soft); border: 1px solid var(--line-2); border-radius: 50%; }
  .finish-demo li > p { min-width: 0; }
  .finish-demo b { display: block; color: var(--ink); font-size: 1rem; }
  .finish-demo small { display: block; color: var(--ink-3); font-size: .875rem; }
  @media (prefers-reduced-motion: no-preference) {
    [data-theatre-ready] .format-card { animation: card-arrive .6s cubic-bezier(.22, 1, .36, 1) both; }
    [data-theatre-ready] .finish-demo li { animation: chapter-in .45s calc(var(--step) * 100ms) both; }
  }
  @keyframes chapter-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes card-arrive { from { opacity: 0; transform: translateY(15px) rotate(2deg); } to { opacity: 1; transform: none; } }
  @media (max-width: 760px) {
    .chapter-panel { min-width: 0; min-height: 0; grid-template-columns: minmax(0, 1fr); gap: 1.75rem; }
    .chapter-copy h3 { max-width: 22ch; }
    .chapter-copy > p:not(.eyebrow) { max-width: 55ch; }
    .chapter-switcher button { justify-content: center; gap: .5rem; padding-inline: .6rem; }
  }
  @container (max-width: 14rem) {
    .chapter-switcher { grid-template-columns: minmax(0, 1fr); }
    .chapter-switcher button { border-right: 0; border-bottom: 1px solid var(--line-2); }
  }
  @media (max-width: 380px) {
    .tab-number { display: none; }
    .transfer-demo, .finish-demo { padding: 1rem; }
    .demo-actions { gap: .3rem; }
    .demo-actions button { padding-inline: .65rem; }
    .window-top small { font-size: .8rem; }
    .format-card { padding-inline: 1rem; }
  }
</style>
