---
import { product } from '../data/site';
import Kicker from './Kicker.astro';

const [transferStory, captureStory, finishStory] = product.stories;

/* A manually configured eight-range transfer is used only as an inspectable example. */
const lanes = [
  { n: '01', seed: 18, hold: 64, byte: '531,382,272' },
  { n: '02', seed: 11, hold: 49, byte: '1,253,949,440' },
  { n: '03', seed: 26, hold: 86, byte: '2,335,014,912' },
  { n: '04', seed: 15, hold: 58, byte: '3,078,045,696' },
  { n: '05', seed: 22, hold: 72, byte: '4,026,531,840' },
  { n: '06', seed: 28, hold: 91, byte: '4,711,964,672' },
  { n: '07', seed: 13, hold: 53, byte: '5,710,567,424' },
  { n: '08', seed: 20, hold: 78, byte: '6,194,479,104' },
] as const;
---

<section id="product" class="section theatre" data-transfer-theatre>
  <div class="container">
    <header class="theatre-intro" data-reveal>
      <Kicker num={product.num} label={product.label} />
      <div class="intro-copy">
        <h2>Watch the whole job move.</h2>
        <p class="lead">
          From the first link to the final folder, each stage stays legible and
          under your control.
        </p>
      </div>
    </header>

    <div class="theatre-shell" data-reveal>
      <nav class="chapter-switcher" role="tablist" aria-label="CloakDrop workflow">
        {
          product.stories.map((chapter, index) => (
            <button
              id={`theatre-tab-${chapter.id}`}
              class="chapter-tab"
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`theatre-panel-${chapter.id}`}
              tabindex={index === 0 ? '0' : '-1'}
              data-chapter-tab={chapter.id}
            >
              <span class="chapter-number">{chapter.n}</span>
              <span class="tab-copy">
                <b>{chapter.label}</b>
                <span>{chapter.title}</span>
              </span>
            </button>
          ))
        }
      </nav>

      <div class="chapter-stage">
        <article
          id="theatre-panel-transfer"
          class="chapter-panel transfer-panel"
          role="tabpanel"
          aria-labelledby="theatre-tab-transfer"
          data-chapter-panel="transfer"
        >
          <header class="chapter-head">
            <div class="chapter-label">
              <span>01</span>
              <p>Transfer</p>
            </div>
            <div class="chapter-copy">
              <p class="overline">CONFIGURED EXAMPLE / 8 PLANNED RANGES</p>
              <h3>Close the app. Keep your place.</h3>
              <p>{transferStory.body}</p>
            </div>
            <ul class="chapter-facts" aria-label="Transfer capabilities">
              <li>Automatic or manual count</li>
              <li>Validated range responses</li>
              <li>Safe single-stream fallback</li>
            </ul>
          </header>

          <div class="transfer-machine" data-simulation data-sim-state="idle">
            <div class="machine-bar">
              <div class="file-lockup">
                <span class="file-mark" aria-hidden="true">CD</span>
                <span>
                  <b>ubuntu-26.04.iso</b>
                  <small>6.52 GB · manual eight-connection example</small>
                </span>
              </div>
              <p class="phase-pill">
                <i aria-hidden="true"></i>
                <span data-phase-text role="status" aria-live="polite" aria-atomic="true">
                  Ready — configured ranges primed
                </span>
              </p>
            </div>

            <div class="lane-field">
              <div class="lane-scale" aria-hidden="true">
                <span>RANGE</span>
                <span>START</span>
                <span>SAVED BYTE</span>
                <span>END</span>
              </div>
              <ol class="lanes" aria-label="Eight byte ranges in this configured example, each with an independent resume marker">
                {
                  lanes.map((lane) => (
                    <li
                      style={`--seed:${lane.seed}%;--hold:${lane.hold}%`}
                      aria-label={`Range ${lane.n}; saved resume marker at byte ${lane.byte}`}
                    >
                      <b>{lane.n}</b>
                      <div class="lane-track" aria-hidden="true">
                        <span class="lane-fill"></span>
                        <i class="resume-marker"></i>
                      </div>
                      <code>{lane.byte}</code>
                    </li>
                  ))
                }
              </ol>

              <div class="relaunch-screen" aria-hidden="true">
                <span class="relaunch-orbit"><i></i><i></i><i></i></span>
                <b>Restoring transfer state</b>
                <small>All saved resume markers found locally</small>
              </div>
            </div>

            <div class="machine-footer">
              <p>
                <span>STATE FILE</span>
                <code>ubuntu-26.04.iso.cdpart</code>
              </p>
              <div class="simulation-actions">
                <button class="simulate-button" type="button" data-simulate>
                  <span data-simulate-label>Simulate relaunch</span>
                  <i aria-hidden="true">↻</i>
                </button>
                <button class="reset-button" type="button" data-reset disabled>Reset</button>
              </div>
            </div>
          </div>

          <p class="simulation-note">
            Manual demonstration. It never starts or repeats on its own.
          </p>
        </article>

        <article
          id="theatre-panel-capture"
          class="chapter-panel capture-panel"
          role="tabpanel"
          aria-labelledby="theatre-tab-capture"
          data-chapter-panel="capture"
        >
          <header class="chapter-head">
            <div class="chapter-label">
              <span>02</span>
              <p>Capture</p>
            </div>
            <div class="chapter-copy">
              <p class="overline">FOUR WAYS IN / ONE LOCAL PATH</p>
              <h3>Bring the link. Keep your flow.</h3>
              <p>{captureStory.body}</p>
            </div>
            <ul class="chapter-facts" aria-label="Capture capabilities">
              <li>Built-in WebKit browser</li>
              <li>Bundled video resolver</li>
              <li>Files, HLS and DASH</li>
            </ul>
          </header>

          <div class="capture-map">
            <div class="capture-inputs" aria-label="Ways to add a link">
              <div class="capture-card">
                <span aria-hidden="true">⌘V</span>
                <p><b>Paste</b><small>A copied URL</small></p>
              </div>
              <div class="capture-card">
                <span aria-hidden="true">↘</span>
                <p><b>Drag</b><small>A link or page URL</small></p>
              </div>
              <div class="capture-card">
                <span aria-hidden="true">↑</span>
                <p><b>Share</b><small>From another app</small></p>
              </div>
              <div class="capture-card">
                <span aria-hidden="true">◎</span>
                <p><b>Browse</b><small>Built-in WebKit</small></p>
              </div>
            </div>

            <div class="flow-line" aria-hidden="true"><i></i><span>→</span></div>

            <div class="resolver-card">
              <div class="resolver-topline">
                <span>ON-DEVICE RESOLVER</span>
                <i>READY</i>
              </div>
              <div class="resolver-number"><b>Bundled</b><span>supported-page resolver</span></div>
              <ul>
                <li><span>FILES</span><b>HTTP · HTTPS · FTP</b></li>
                <li><span>MEDIA</span><b>HLS · DASH · VIDEO</b></li>
                <li><span>PAYLOAD</span><b>CLOAKDROP ENGINE</b></li>
              </ul>
            </div>

            <div class="flow-line" aria-hidden="true"><i></i><span>→</span></div>

            <div class="engine-card">
              <span class="engine-pulse" aria-hidden="true"><i></i><i></i><i></i></span>
              <p class="overline">SAME NATIVE ENGINE</p>
              <h4>One queue, whatever the source.</h4>
              <p>
                Files and media enter the same sandboxed transfer system. yt-dlp can
                resolve a submitted page; CloakDrop transfers the selected payload.
              </p>
            </div>
          </div>
        </article>

        <article
          id="theatre-panel-finish"
          class="chapter-panel finish-panel"
          role="tabpanel"
          aria-labelledby="theatre-tab-finish"
          data-chapter-panel="finish"
        >
          <header class="chapter-head">
            <div class="chapter-label">
              <span>03</span>
              <p>Finish</p>
            </div>
            <div class="chapter-copy">
              <p class="overline">ROUTING / LIMITS / POST-PROCESSING</p>
              <h3>Set the rules once.</h3>
              <p>{finishStory.body}</p>
            </div>
            <ul class="chapter-facts" aria-label="Finishing capabilities">
              <li>First-match routing rules</li>
              <li>Shared aggregate limits</li>
              <li>Optional post-processing</li>
            </ul>
          </header>

          <div class="finish-board">
            <div class="routing-column">
              <p class="board-label">RULE MATCHED</p>
              <div class="route-source">
                <span aria-hidden="true">MOV</span>
                <p><b>lecture-07.webm</b><small>MEDIA / VIDEO</small></p>
              </div>
              <div class="route-rule">
                <span>IF</span>
                <b>Type is video</b>
                <i aria-hidden="true">↓</i>
                <span>THEN</span>
                <b>Movies folder · 24 MB/s cap</b>
              </div>
            </div>

            <div class="queue-column">
              <div class="queue-heading">
                <p><span class="board-label">MAIN QUEUE</span><b>2 active</b></p>
                <small>The queue persists order. The limiter owns the total.</small>
              </div>
              <div class="queue-list">
                <div class="queue-item is-active">
                  <span>01</span><p><b>lecture-07.webm</b><small>12.6 MB/s</small></p><i>ACTIVE</i>
                </div>
                <div class="queue-item is-active">
                  <span>02</span><p><b>field-notes.zip</b><small>8.4 MB/s</small></p><i>ACTIVE</i>
                </div>
                <div class="queue-item">
                  <span>03</span><p><b>soundtrack.flac</b><small>Scheduled for 19:00</small></p><i>SCHEDULED</i>
                </div>
              </div>
              <div class="bandwidth-meter">
                <p><span>AGGREGATE LIMIT</span><b>24 MB/s</b></p>
                <div aria-hidden="true"><i></i></div>
                <small>One sustained cap shared across active workers.</small>
              </div>
            </div>

            <div class="finish-column">
              <p class="board-label">AFTER TRANSFER</p>
              <ol>
                <li><span>01</span><p><b>Combine media</b><small>Audio + video, no re-encode</small></p><i>READY</i></li>
                <li><span>02</span><p><b>Guarded extraction</b><small>ZIP-Slip and bomb checks</small></p><i>OPTIONAL</i></li>
                <li><span>03</span><p><b>Run an all-done action</b><small>When no unfinished work remains</small></p><i>OPTIONAL</i></li>
              </ol>
              <div class="destination">
                <span aria-hidden="true">⌂</span>
                <p><small>DESTINATION</small><b>Movies / Lectures</b></p>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-transfer-theatre]').forEach((root) => {
      if (root.dataset.theatreReady === 'true') return;
      root.dataset.theatreReady = 'true';

      const tabs = Array.from(root.querySelectorAll('[data-chapter-tab]'));
      const panels = Array.from(root.querySelectorAll('[data-chapter-panel]'));
      let activeKey = tabs.find((tab) => tab.getAttribute('aria-selected') === 'true')?.dataset.chapterTab ?? 'transfer';

      const showChapter = (key, moveFocus = false) => {
        activeKey = key;
        tabs.forEach((tab) => {
          const selected = tab.dataset.chapterTab === key;
          tab.setAttribute('aria-selected', selected ? 'true' : 'false');
          tab.tabIndex = selected ? 0 : -1;
          if (selected && moveFocus) tab.focus();
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.chapterPanel !== key;
        });
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => showChapter(tab.dataset.chapterTab));
        tab.addEventListener('keydown', (event) => {
          let next = index;
          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % tabs.length;
          else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + tabs.length) % tabs.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = tabs.length - 1;
          else return;
          event.preventDefault();
          showChapter(tabs[next].dataset.chapterTab, true);
        });
      });

      showChapter(activeKey);

      const simulation = root.querySelector('[data-simulation]');
      const simulate = root.querySelector('[data-simulate]');
      const simulateLabel = root.querySelector('[data-simulate-label]');
      const resetButton = root.querySelector('[data-reset]');
      const phase = root.querySelector('[data-phase-text]');
      if (!simulation || !simulate || !simulateLabel || !resetButton || !phase) return;

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const timings = reducedMotion
        ? [120, 780, 1480, 1980, 2180]
        : [950, 1900, 2920, 3500, 4700];
      let timers = [];

      const clearTimers = () => {
        timers.forEach((timer) => window.clearTimeout(timer));
        timers = [];
      };

      const setPhase = (state, label) => {
        simulation.dataset.simState = state;
        phase.textContent = label;
      };

      const schedule = (at, callback) => {
        timers.push(window.setTimeout(callback, at));
      };

      const reset = () => {
        clearTimers();
        setPhase('idle', 'Ready — configured ranges primed');
        simulate.disabled = false;
        simulateLabel.textContent = 'Simulate relaunch';
        resetButton.disabled = true;
      };

      const run = () => {
        clearTimers();
        setPhase('running', 'Transfer active — planned ranges moving');
        simulate.disabled = true;
        simulateLabel.textContent = 'Simulation running';
        resetButton.disabled = false;

        schedule(timings[0], () => {
          setPhase('interrupted', 'Connection interrupted — exact offsets saved');
        });
        schedule(timings[1], () => {
          setPhase('relaunching', 'CloakDrop relaunching — restoring local state');
        });
        schedule(timings[2], () => {
          setPhase('resumed', 'Restored — saved ranges resume at their recorded bytes');
        });
        schedule(timings[3], () => {
          setPhase('finishing', 'Transfer resumed — continuing without starting over');
        });
        schedule(timings[4], () => {
          setPhase('complete', 'Transfer complete — saved ranges did not restart');
          simulate.disabled = false;
          simulateLabel.textContent = 'Replay simulation';
        });
      };

      simulate.addEventListener('click', () => {
        if (simulation.dataset.simState === 'complete') reset();
        window.requestAnimationFrame(run);
      });
      resetButton.addEventListener('click', reset);
    });
  })();
</script>

<style>
  .theatre {
    overflow: clip;
    padding-block: clamp(3.75rem, 6vw, 6rem);
  }

  .theatre-intro {
    display: grid;
    gap: 1.4rem;
  }

  .intro-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(260px, 0.65fr);
    align-items: end;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .intro-copy h2 {
    max-width: 12ch;
  }

  .intro-copy .lead {
    max-width: 42ch;
  }

  .theatre-shell {
    margin-top: clamp(2rem, 3.5vw, 3.25rem);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: 0 38px 90px -64px rgba(12, 17, 20, 0.7);
    overflow: hidden;
  }

  .chapter-switcher {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--line-2);
    background: color-mix(in srgb, var(--surface-2) 72%, var(--surface));
  }

  .chapter-tab {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.9rem;
    min-height: 76px;
    padding: 0.95rem clamp(1rem, 2.2vw, 1.6rem);
    border: 0;
    border-right: 1px solid var(--line-2);
    color: var(--ink-3);
    background: transparent;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: color 180ms ease, background 180ms ease;
  }

  .chapter-tab:last-child {
    border-right: 0;
  }

  .chapter-tab::after {
    content: '';
    position: absolute;
    inset: auto 1rem -1px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .chapter-tab:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--surface) 78%, transparent);
  }

  .chapter-tab[aria-selected='true'] {
    color: var(--ink);
    background: var(--surface);
  }

  .chapter-tab[aria-selected='true']::after {
    transform: scaleX(1);
  }

  .chapter-number,
  .chapter-label span,
  .overline,
  .board-label,
  .lane-scale,
  .phase-pill,
  .machine-footer > p > span,
  .resolver-topline,
  .destination small {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 550;
    letter-spacing: 0.065em;
    text-transform: uppercase;
  }

  .chapter-number {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    color: var(--accent-ink);
  }

  .tab-copy {
    display: grid;
    gap: 0.18rem;
    min-width: 0;
  }

  .tab-copy b {
    color: inherit;
    font-size: 0.88rem;
    line-height: 1.2;
  }

  .tab-copy span {
    overflow: hidden;
    color: var(--ink-4);
    font-size: 0.72rem;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chapter-stage {
    position: relative;
    min-height: 0;
    background-color: var(--surface-2);
    background-image:
      linear-gradient(color-mix(in srgb, var(--line) 55%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--line) 55%, transparent) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .chapter-panel {
    display: grid;
    gap: clamp(1.35rem, 2.2vw, 2.1rem);
    min-height: 0;
    padding: clamp(1.4rem, 2.5vw, 2.4rem);
    animation: chapter-enter 340ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .chapter-panel[hidden] {
    display: none;
  }

  .chapter-head {
    display: grid;
    grid-template-columns: minmax(340px, 1.25fr) minmax(210px, 0.6fr);
    align-items: end;
    gap: clamp(1.25rem, 3vw, 3rem);
  }

  .chapter-label {
    display: none;
  }

  .chapter-copy {
    display: grid;
    gap: 0.62rem;
  }

  .overline,
  .board-label {
    color: var(--accent-ink);
  }

  .chapter-copy h3 {
    max-width: 18ch;
    font-size: clamp(1.75rem, 1.35rem + 1.3vw, 2.55rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .chapter-copy > p:last-child {
    max-width: 64ch;
    color: var(--ink-3);
    line-height: 1.58;
  }

  .chapter-facts {
    display: grid;
    gap: 0.55rem;
    padding: 0;
    list-style: none;
  }

  .chapter-facts li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    color: var(--ink-2);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .chapter-facts li::before {
    content: '';
    width: 5px;
    height: 5px;
    margin-top: 0.42em;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  /* Transfer simulation -------------------------------------------------- */
  .transfer-machine {
    align-self: end;
    border: 1px solid color-mix(in srgb, var(--accent) 26%, var(--line-2));
    border-radius: 18px;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .machine-bar,
  .machine-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    background: color-mix(in srgb, var(--surface) 86%, var(--surface-2));
  }

  .machine-bar {
    border-bottom: 1px solid var(--line);
  }

  .file-lockup {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }

  .file-mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    color: #fff;
    background: linear-gradient(145deg, var(--accent), var(--accent-strong));
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .file-lockup > span:last-child {
    display: grid;
    min-width: 0;
  }

  .file-lockup b {
    overflow: hidden;
    color: var(--ink);
    font-size: 0.82rem;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .file-lockup small {
    color: var(--ink-4);
    font-family: var(--font-mono);
    font-size: 0.59rem;
  }

  .phase-pill {
    display: flex;
    align-items: center;
    gap: 0.48rem;
    max-width: 54%;
    color: var(--ink-3);
    letter-spacing: 0.02em;
    text-align: right;
  }

  .phase-pill i {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  [data-sim-state='interrupted'] .phase-pill i {
    background: #b8622c;
    box-shadow: 0 0 0 4px color-mix(in srgb, #b8622c 14%, transparent);
  }

  [data-sim-state='complete'] .phase-pill i {
    background: var(--positive);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--positive) 14%, transparent);
  }

  .lane-field {
    position: relative;
    min-height: 282px;
    padding: 1.1rem;
    background:
      linear-gradient(90deg, transparent 24.8%, var(--line) 25%, transparent 25.2%, transparent 49.8%, var(--line) 50%, transparent 50.2%, transparent 74.8%, var(--line) 75%, transparent 75.2%),
      var(--surface);
  }

  .lane-scale {
    display: grid;
    grid-template-columns: 38px 1fr 132px;
    gap: 0.8rem;
    margin-bottom: 0.52rem;
    color: var(--ink-4);
    font-size: 0.54rem;
  }

  .lane-scale span:nth-child(2) {
    display: flex;
    justify-content: space-between;
  }

  .lane-scale span:nth-child(2)::after {
    content: 'END';
  }

  .lane-scale span:nth-child(4) {
    display: none;
  }

  .lanes {
    display: grid;
    gap: 0.48rem;
    padding: 0;
    list-style: none;
  }

