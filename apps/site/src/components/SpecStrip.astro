---
import { stats } from '../data/site';
import Icon from './Icon.astro';
---

<section class="specs-wrap" aria-label="Product proof" data-reveal>
  <div class="container">
    <ul class="specs">
      {
        stats.map((stat) => (
          <li class:list={['cell', { 'cell--accent': stat.accent }] }>
            <a href={stat.href} rel={stat.href?.startsWith('http') ? 'noopener' : undefined}>
              <span
                class="val"
                data-count-to={stat.countTo}
                data-count-prefix={stat.countPrefix}
                data-count-suffix={stat.countSuffix}
                data-count-comma={stat.countComma ? '' : undefined}
              >
                {stat.value}
              </span>
              <span class="lbl">{stat.label}</span>
              <span class="go" aria-hidden="true"><Icon name="arrow" size={15} /></span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .specs-wrap {
    margin-top: clamp(1.25rem, 3vw, 2rem);
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
    padding: 0;
    border-block: 1px solid var(--line-2);
  }

  .cell + .cell {
    border-left: 1px solid var(--line);
  }

  .cell a {
    position: relative;
    display: block;
    min-height: 100%;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) clamp(1rem, 2.5vw, 2rem);
    transition: background 0.18s ease;
  }

  .cell a:hover {
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }

  .val {
    display: block;
    font-size: clamp(1.9rem, 1.1rem + 2.6vw, 2.75rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink);
  }

  .cell--accent .val {
    color: var(--accent-ink);
  }

  .lbl {
    display: block;
    margin-top: 0.45rem;
    padding-right: 1.2rem;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--ink-4);
  }

  .go {
    position: absolute;
    right: 1rem;
    bottom: 1.2rem;
    color: var(--ink-4);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  .cell a:hover .go,
  .cell a:focus-visible .go {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 640px) {
    .specs {
      grid-template-columns: 1fr 1fr;
    }
    .cell:nth-child(3) {
      border-left: 0;
    }
    .cell:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .cell a {
      min-height: 7.8rem;
      padding: 1.25rem 1rem;
    }
    .go {
      display: none;
    }
  }
</style>
