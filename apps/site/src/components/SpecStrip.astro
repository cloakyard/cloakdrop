---
import { stats } from '../data/site';
---

<section class="specs-wrap" aria-label="Product proof" data-reveal>
  <div class="container ledger">
    <div class="ledger-key" aria-hidden="true">
      <span>System proof</span>
      <b>04 signals</b>
    </div>

    <ul class="specs">
      {
        stats.map((stat, index) => (
          <li class:list={['cell', { 'cell--accent': 'accent' in stat && stat.accent }] }>
            <a href={stat.href} rel={stat.href?.startsWith('http') ? 'noopener' : undefined}>
              <span class="index">{String(index + 1).padStart(2, '0')}</span>
              <span class="val">{stat.value}</span>
              <span class="lbl">{stat.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .specs-wrap {
    border-block: 1px solid var(--line-2);
  }

  .ledger {
    display: grid;
    grid-template-columns: minmax(9rem, 0.65fr) minmax(0, 5fr);
  }

  .ledger-key {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.35rem clamp(1rem, 2.5vw, 2rem) 1.35rem 0;
    border-right: 1px solid var(--line-2);
    color: var(--ink-4);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.045em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .ledger-key b {
    color: var(--ink-3);
    font-size: inherit;
    font-weight: 600;
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    min-width: 0;
    padding: 0;
    list-style: none;
  }

  .cell + .cell {
    border-left: 1px solid var(--line);
  }

  .cell a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-content: space-between;
    min-height: 8.25rem;
    padding: 1.25rem clamp(0.9rem, 2vw, 1.65rem);
    transition: background 0.18s ease;
  }

  .cell a:hover {
    background: color-mix(in srgb, var(--accent) 4.5%, transparent);
  }

  .index {
    grid-column: 2;
    grid-row: 1;
    color: var(--ink-4);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .val {
    grid-column: 1;
    grid-row: 1;
    color: var(--ink);
    font-size: clamp(2rem, 1.45rem + 1.5vw, 2.8rem);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .cell--accent .val {
    color: var(--positive);
  }

  .lbl {
    grid-column: 1 / -1;
    align-self: end;
    width: fit-content;
    color: var(--ink-4);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    line-height: 1.4;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition:
      color 0.18s ease,
      text-decoration-color 0.18s ease;
  }

  .cell a:hover .lbl,
  .cell a:focus-visible .lbl {
    color: var(--ink-2);
    text-decoration-color: var(--line-2);
  }

  @media (max-width: 900px) {
    .ledger {
      grid-template-columns: 1fr;
    }

    .ledger-key {
      flex-direction: row;
      gap: 1rem;
      padding: 0.85rem 0;
      border-right: 0;
      border-bottom: 1px solid var(--line-2);
    }

    .cell:first-child a {
      padding-left: 0;
    }

    .cell:last-child a {
      padding-right: 0;
    }
  }

  @media (max-width: 640px) {
    .specs {
      grid-template-columns: 1fr 1fr;
    }

    .cell:nth-child(3) {
      border-left: 0;
    }

    .cell:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    .cell:first-child a,
    .cell:nth-child(3) a {
      padding-left: 0;
    }

    .cell:nth-child(2) a,
    .cell:last-child a {
      padding-right: 0;
    }

    .cell a {
      min-height: 7.7rem;
      padding-block: 1.15rem;
    }
  }

  @media (max-width: 360px) {
    .cell a {
      min-height: 7.35rem;
      padding-inline: 0.7rem;
    }

    .cell:first-child a,
    .cell:nth-child(3) a {
      padding-left: 0;
    }

    .cell:nth-child(2) a,
    .cell:last-child a {
      padding-right: 0;
    }

    .val {
      font-size: 1.85rem;
    }

    .lbl {
      font-size: 0.67rem;
    }
  }
</style>
