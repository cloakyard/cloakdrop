---
import { privacy, site } from '../data/site';
import Kicker from './Kicker.astro';
import Icon from './Icon.astro';
---

<section id="privacy" class="section privacy" data-reveal>
  <div class="container">
    <div class="card">
      <div class="copy">
        <Kicker num={privacy.num} label={privacy.label} />
        <h2>{privacy.title}</h2>
        <p class="body">{privacy.body}</p>
        <a
          class="policy-link"
          href={site.privacyPolicy}
        >Read the privacy policy <Icon name="arrow" size={16} /></a>
      </div>

      <ul class="list">
        {
          privacy.points.map((p) => (
            <li>
              <Icon name="check" size={16} stroke={2.4} />
              <span>{p}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-xl);
    padding: clamp(2.25rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: clamp(2rem, 5vw, 3.5rem);
    box-shadow: var(--shadow-card);
  }

  .copy h2 {
    margin-top: 1.5rem;
    font-size: var(--t-h2-band);
    max-width: 18ch;
  }

  .body {
    margin-top: 1.4rem;
    color: var(--ink-2);
    line-height: 1.7;
    max-width: 52ch;
  }

  .policy-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-top: 1rem;
    color: var(--accent-ink);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .policy-link :global(svg) {
    transition: transform 0.16s ease;
  }

  .policy-link:hover :global(svg) {
    transform: translateX(3px);
  }

  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-left: 1px solid var(--line);
    padding-left: clamp(1.5rem, 3vw, 2.5rem);
  }

  .list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--ink-2);
  }

  .list li:last-child {
    border-bottom: 0;
  }

  .list :global(svg) {
    color: var(--accent-ink);
    flex: none;
  }

  @media (max-width: 820px) {
    .card {
      grid-template-columns: 1fr;
    }
    .list {
      border-left: 0;
      border-top: 1px solid var(--line);
      padding-left: 0;
      padding-top: 0.5rem;
    }
    .copy h2 {
      max-width: none;
    }
  }
</style>
