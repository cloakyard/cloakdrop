---
import { downloads, hood, site } from '../data/site';
import Kicker from './Kicker.astro';
import Icon from './Icon.astro';
---

<section id="download" class="download" data-reveal>
  <div class="container download-grid">
    <div class="copy">
      <Kicker num="05" label="Download" tone="band" />

      <div class="status"><i aria-hidden="true"></i><span>Public beta status</span></div>
      <h2>Follow the beta at the source.</h2>
      <p class="body">
        {downloads.status} GitHub Releases is the source of truth for builds,
        checksums, release notes, and current installation guidance—without an updater
        account or mailing-list gate.
      </p>

      <div class="requirements" aria-label="System requirements">
        <span>Apple silicon</span>
        <span>macOS 26 or later</span>
        <span>Free · MIT licensed</span>
      </div>

      <div class="actions">
        <a class="download-action" href={downloads.href} rel="noopener">
          <Icon name="download" size={18} stroke={2} />
          {downloads.actionLabel}
        </a>
        <a class="source-link" href={site.repo} rel="noopener">
          <Icon name="github" size={17} />
          Read the source
          <Icon name="arrow" size={15} />
        </a>
      </div>
    </div>

    <aside class="engineering" aria-labelledby="engineering-title">
      <p class="engineering-kicker">OPEN ENGINEERING NOTE</p>
      <h3 id="engineering-title">{hood.title}</h3>
      <p>{hood.body}</p>
      <dl>
        {hood.specs.map((spec) => (
          <div>
            <dt>{spec.k}</dt>
            <dd>{spec.v}</dd>
          </div>
        ))}
      </dl>
    </aside>
  </div>
</section>

<style>
  .download {
    position: relative;
    overflow: clip;
    padding-block: clamp(5.5rem, 11vw, 10rem);
    color: #c4d0d5;
    background: #071014;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .download::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent 0 49.95%, rgba(255,255,255,.035) 50%, transparent 50.05%),
      linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px);
    background-size: 100% 100%, 100% 6rem;
    mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
  }

  .download-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(22rem, 0.72fr);
    gap: clamp(4rem, 10vw, 10rem);
    align-items: center;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    color: #8fa1a9;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #d6a74b;
    box-shadow: 0 0 0 5px rgba(214, 167, 75, 0.11);
  }

  h2 {
    max-width: 11ch;
    margin-top: 1.2rem;
    color: #f7fbfc;
    font-size: clamp(2.7rem, 5.8vw, 5.8rem);
    font-weight: 770;
    letter-spacing: -0.055em;
  }

  .body {
    max-width: 51ch;
    margin-top: 1.6rem;
    color: #9babb2;
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    line-height: 1.72;
  }

  .requirements {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.2rem;
    margin-top: 1.8rem;
    color: #b8c6cb;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .requirements span {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
  }

  .requirements span:not(:last-child)::after {
    content: '';
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #49616b;
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 2.25rem;
  }

  .download-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 54px;
    padding: 0 1.35rem;
    border: 1px solid #f4f8f9;
    border-radius: 12px;
    color: #071014;
    background: #f4f8f9;
    font-weight: 720;
    transition: transform .16s ease, background .16s ease;
  }

  .download-action:hover {
    transform: translateY(-2px);
    background: #dfecef;
  }

  .source-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 54px;
    padding-inline: 1.35rem;
    color: #bdcbd0;
    font-size: 0.88rem;
    font-weight: 650;
  }

  .source-link :global(svg:last-child) {
    color: #73bcd1;
    transition: transform .16s ease;
  }

  .source-link:hover :global(svg:last-child) {
    transform: translateX(4px);
  }

  .engineering {
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .engineering-kicker {
    color: #6faec1;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .engineering h3 {
    max-width: 16ch;
    margin-top: 1rem;
    color: #f5f9fa;
    font-size: clamp(1.45rem, 2.6vw, 2.15rem);
    font-weight: 700;
    line-height: 1.08;
  }

  .engineering > p:not(.engineering-kicker) {
    max-width: 44ch;
    margin-top: 1rem;
    color: #899ca4;
    font-size: 0.88rem;
    line-height: 1.65;
  }

  dl {
    margin-top: 1.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  dl div {
    display: grid;
    grid-template-columns: 7.3rem 1fr;
    gap: 1rem;
    padding-block: 0.82rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  dt { color: #657b84; }
  dd { margin: 0; color: #c6d1d5; }

  @media (max-width: 860px) {
    .download-grid {
      grid-template-columns: 1fr;
      gap: 4.5rem;
    }
    .engineering {
      max-width: 38rem;
    }
  }

  @media (max-width: 520px) {
    .download {
      padding-block: 4.5rem 5rem;
    }
    h2 {
      font-size: clamp(2.55rem, 13vw, 4rem);
    }
    .requirements {
      display: grid;
      gap: 0.5rem;
    }
    .requirements span::after {
      display: none;
    }
    .actions {
      display: grid;
      align-items: stretch;
    }
    .download-action,
    .source-link {
      width: 100%;
    }
    .source-link {
      justify-content: center;
    }
    dl div {
      grid-template-columns: 5.8rem minmax(0, 1fr);
      gap: .75rem;
      font-size: .65rem;
    }
  }
</style>
