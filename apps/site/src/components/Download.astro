---
import { downloads, site } from '../data/site';
import Icon from './Icon.astro';
---
<section id="download" class="section frame" tabindex="-1" aria-labelledby="download-title">
  <div class="download-grid">
    <div class="section-intro">
      <p class="eyebrow">Yours to download</p>
      <h2 id="download-title">A little more care. For every download.</h2>
      <p>{downloads.note}<br />Free · Open source</p>
      <a class="air-button air-button--primary" href={downloads.href}>
        <Icon name="download" size={18} />{downloads.actionLabel}
      </a>
      <p class="detail release-note">{downloads.status}</p>
    </div>
    <div class="install" aria-labelledby="install-title">
      <h3 id="install-title">On your Mac in a few steps.</h3>
      <ol>
        <li>Download the <strong>.dmg</strong> asset from <a href={downloads.href}>GitHub Releases</a>.</li>
        <li>Open it, drag <strong>CloakDrop</strong> to <strong>Applications</strong>, then open the app.</li>
        <li>If macOS blocks it and you trust the download, go to <strong>System Settings → Privacy &amp; Security → Open Anyway</strong>, then confirm <strong>Open</strong>.</li>
      </ol>
      <p class="detail">Current builds are locally signed and <strong>not notarized</strong>.
        Check the release notes for the signing status of the build you download.
        <a href="https://support.apple.com/en-us/102445">Apple’s opening guide</a> · <a href={site.repo + '/issues'}>Share feedback</a></p>
    </div>
  </div>
</section>
