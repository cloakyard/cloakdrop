---
import { downloads, site } from '../data/site';
import Kicker from './Kicker.astro';
import Icon from './Icon.astro';
---

<section id="download" class="section download" data-reveal>
  <div class="container">
    <div class="panel">
      <div class="copy">
        <Kicker num="05" label="Download & install" tone="band" />
        <p class="status"><i aria-hidden="true"></i> Release status</p>
        <h2>Ready when the beta lands.</h2>
        <p class="body">
          {downloads.status} GitHub Releases is the source of truth for signed
          artifacts, checksums, and release notes—no updater service or account required.
        </p>
        <div class="requirements" aria-label="Requirements">
          <span>Apple silicon</span>
          <span>macOS 27</span>
          <span>Free · MIT</span>
        </div>
        <div class="actions">
          <a class="btn btn--light" href={downloads.href} rel="noopener">
            <Icon name="download" size={17} stroke={2} />
            {downloads.actionLabel}
          </a>
          <a class="btn btn--ghost" href={site.repo} rel="noopener">
            <Icon name="github" size={17} />
            View source
          </a>
        </div>
      </div>

      <div class="install" aria-label="Beta installation steps">
        <p class="install-label">When a build is available</p>
        <ol>
          <li><span>01</span><div><strong>Download the DMG</strong><p>Choose the Apple silicon asset and verify its published checksum.</p></div></li>
          <li><span>02</span><div><strong>Move it to Applications</strong><p>Open the DMG and drag CloakDrop into Applications.</p></div></li>
          <li><span>03</span><div><strong>Right-click, then Open</strong><p>The beta is not notarized yet, so approve the first launch explicitly.</p></div></li>
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .panel {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.95fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    padding: clamp(2.25rem, 5vw, 4.5rem);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-xl);
    color: #d8e3e7;
    background:
      radial-gradient(circle at 15% 0%, rgba(94, 182, 201, 0.28), transparent 38%),
      radial-gradient(circle at 100% 100%, rgba(42, 123, 155, 0.22), transparent 42%),
      #0b1115;
    box-shadow: var(--shadow-window);
  }

  .copy,
  .install {
    position: relative;
    z-index: 1;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #9fb0b7;
  }

  .status i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #e6bc58;
    box-shadow: 0 0 0 5px rgba(230, 188, 88, 0.12);
  }

  h2 {
    max-width: 12ch;
    margin-top: 1rem;
    color: #fff;
    font-size: var(--t-h2-band);
  }

  .body {
    max-width: 52ch;
    margin-top: 1.3rem;
    color: #aebbc1;
    line-height: 1.7;
  }

  .requirements {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.35rem;
  }

  .requirements span {
    padding: 0.35rem 0.62rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: #c5d2d7;
    background: rgba(255, 255, 255, 0.04);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .btn--light {
    border-color: #fff;
    color: #11191d;
    background: #fff;
    box-shadow: 0 18px 40px -22px rgba(255, 255, 255, 0.7);
  }

  .btn--light:hover {
    background: #eef6f8;
  }

  .btn--ghost {
    border-color: rgba(255, 255, 255, 0.18);
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
  }

  .btn--ghost:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .install {
    align-self: center;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.055);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
  }

  .install-label {
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #8fa2a9;
  }

  ol {
    list-style: none;
    padding: 0;
  }

  li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.85rem;
    padding-block: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  li > span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: #7fbdd1;
  }

  li strong {
    color: #fff;
    font-size: 0.9rem;
  }

  li p {
    margin-top: 0.28rem;
    color: #92a2a9;
    font-size: 0.79rem;
    line-height: 1.5;
  }

  @media (max-width: 820px) {
    .panel {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .panel {
      gap: 2rem;
      padding: 1.5rem;
      border-radius: 18px;
    }
    .actions {
      display: grid;
      grid-template-columns: 1fr;
    }
    .actions .btn {
      width: 100%;
    }
    .install {
      padding: 1.1rem;
    }
  }
</style>
