---
import { downloads, site } from '../data/site';
import Icon from './Icon.astro';
interface Props { linkPrefix?: string; }
const { linkPrefix = '' } = Astro.props;
---
<footer class="site-footer frame">
  <div class="footer-inner">
    <p><span translate="no">CloakDrop</span> · Made with care by <a href="https://github.com/sumitsahoo">Sumit Sahoo</a>.</p>
    <nav aria-label="Footer">
      <a href={linkPrefix + downloads.sectionHref}>Download</a>
      <a href={site.repo}>Source</a>
      <a href={site.privacyPolicy} aria-current={Astro.url.pathname === '/privacy/' ? 'page' : undefined}>Privacy</a>
      <a href="https://cloakyard.com">Cloakyard <Icon name="link" size={15} /></a>
    </nav>
  </div>
</footer>
