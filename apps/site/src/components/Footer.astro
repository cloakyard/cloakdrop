---
import { site } from '../data/site';
import Icon from './Icon.astro';

const authorUrl = 'https://github.com/sumitsahoo';
const cloakyardUrl = 'https://cloakyard.com';
const licenseUrl = `${site.repo}/blob/main/LICENSE`;
---

<footer class="footer">
  <div class="container inner">
    <div class="statement-row">
      <div>
        <p class="eyebrow" translate="no">CloakDrop / Cloakyard</p>
        <p class="statement">Resume a download. <span>Keep it local.</span></p>
      </div>

      <nav class="index" aria-label="Footer">
        <a href="#download">Download beta</a>
        <a href={site.repo} target="_blank" rel="noreferrer">GitHub</a>
        <a href={site.privacyPolicy}>Privacy policy</a>
        <a href={cloakyardUrl} target="_blank" rel="noreferrer">
          Cloakyard <Icon name="arrow" size={13} />
        </a>
      </nav>
    </div>

    <div class="meta">
      <div class="identity">
        <span translate="no">CloakDrop beta</span>
        <span aria-hidden="true">/</span>
        <span>
          Built by <a href={authorUrl} target="_blank" rel="noreferrer">Sumit Sahoo</a>
        </span>
      </div>
      <div class="actions">
        <a href={site.privacyPolicy}><Icon name="shield" size={14} />Privacy</a>
        <a href={licenseUrl} target="_blank" rel="noreferrer">MIT licensed</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    color: var(--band-ink-2);
    background: var(--band);
    border-top: 1px solid var(--night-rule, rgba(255, 255, 255, 0.08));
  }

  .inner {
    padding-block: 2rem;
  }

  .statement-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: var(--band-accent);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .statement {
    max-width: 13ch;
    color: var(--band-ink);
    font-size: clamp(2.4rem, 5vw, 5.2rem);
    font-weight: 720;
    letter-spacing: -0.055em;
    line-height: 0.96;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .statement span {
    color: var(--band-accent);
  }

  .index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: end;
    gap: 0.75rem 1.5rem;
    color: var(--band-ink-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .index a,
  .meta a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    color: inherit;
    transition: color 0.16s ease;
  }

  .index a :global(svg) {
    flex: none;
    color: var(--band-accent);
    transition: transform 0.16s ease;
  }

  .index a:hover :global(svg) {
    transform: translateX(3px);
  }

  .meta {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .identity,
  .actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .identity {
    align-items: flex-start;
    flex-direction: column;
    gap: 0.5rem;
  }

  .identity > span[aria-hidden='true'] {
    display: none;
  }

  .actions a {
    gap: 0.5rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .index a:hover,
    .meta a:hover {
      color: var(--band-accent);
    }
  }

  @media (min-width: 860px) {
    .statement-row {
      grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
      gap: 5rem;
    }

    .meta {
      align-items: center;
      flex-direction: row;
    }

    .identity {
      align-items: center;
      flex-direction: row;
      gap: 1rem;
    }

    .identity > span[aria-hidden='true'] {
      display: inline;
    }

    .actions {
      margin-left: auto;
    }
  }
</style>
