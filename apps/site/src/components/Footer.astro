---
import { site } from '../data/site';
import Icon from './Icon.astro';
---
<footer class="air-page-footer site-footer frame">
    <p class="air-page-identity"><span translate="no">CloakDrop</span><span>Built by <a href="https://github.com/sumitsahoo">Sumit Sahoo</a></span></p>
    <nav aria-label="Footer navigation">
      <a href={site.privacyPolicy} aria-current={Astro.url.pathname === '/privacy/' ? 'page' : undefined}>Privacy</a>
      <a href={site.repo}>Source</a>
      <a href={`${site.repo}/blob/main/LICENSE`}>MIT license</a>
      <a href="https://cloakyard.com">Cloakyard <Icon name="link" size={16} /></a>
    </nav>
</footer>
