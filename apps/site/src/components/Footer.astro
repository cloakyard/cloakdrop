---
import { site, suite } from '../data/site';
import Brand from './Brand.astro';
import Icon from './Icon.astro';
---

<footer class="footer">
  <div class="container top">
    <div class="about">
      <Brand size={34} />
      <p>A native, privacy-first download manager with no CloakDrop cloud account.</p>
    </div>

    <nav aria-label="Cloakyard apps">
      <p>Cloakyard</p>
      {
        suite.apps.filter((app) => !app.self).map((app) => (
          <a href={app.href} rel="noopener">{app.name}<Icon name="arrow" size={14} /></a>
        ))
      }
    </nav>

  </div>

  <div class="container bottom">
    <p>© {new Date().getFullYear()} Sumit Sahoo · MIT License</p>
    <p>
      <a href={site.privacyPolicy}>Privacy</a> ·
      <a href={site.repo} rel="noopener">Source</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    color: #8da0a8;
    background: #071014;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .top {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) auto;
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .about p {
    max-width: 38ch;
    margin-top: 0.9rem;
    color: #7f939b;
    font-size: 0.88rem;
  }

  .about :global(.brand-name) {
    color: #eef6f8;
  }

  .about :global(.brand-accent) {
    color: var(--band-accent);
  }

  nav {
    display: grid;
    align-content: start;
    gap: 0.55rem;
  }

  nav > p {
    margin-bottom: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #647b84;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 32px;
    color: #aebfc5;
    font-size: 0.86rem;
    font-weight: 600;
  }

  nav a :global(svg) {
    color: #70b6ca;
    transition: transform 0.16s ease;
  }

  nav a:hover :global(svg) {
    transform: translateX(3px);
  }

  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    padding-block: 1.25rem 1.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: #617780;
  }

  .bottom a {
    color: #9fb2b9;
  }

  @media (max-width: 700px) {
    .top {
      grid-template-columns: 1fr;
    }
    .about {
      grid-column: auto;
    }

    nav a,
    .bottom a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }

  @media (max-width: 420px) {
    .bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
