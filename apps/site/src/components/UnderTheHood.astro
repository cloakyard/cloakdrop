---
import { hood } from '../data/site';
import Kicker from './Kicker.astro';
---

<section id="hood" class="section hood" data-reveal>
  <div class="container">
    <Kicker num={hood.num} label={hood.label} />

    <div class="grid">
      <div class="copy">
        <h2>{hood.title}</h2>
        <p class="body">{hood.body}</p>
      </div>

      <dl class="specs">
        {
          hood.specs.map((s) => (
            <div class="row">
              <dt>{s.k}</dt>
              <dd>{s.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .grid {
    margin-top: 1.6rem;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .copy h2 {
    font-size: var(--t-h2-band);
  }

  .body {
    margin-top: 1.4rem;
    color: var(--ink-2);
    line-height: 1.7;
    max-width: 42ch;
  }

  .specs {
    margin: 0;
    border-top: 1px solid var(--line-2);
    font-family: var(--font-mono);
  }

  .row {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 1.5rem;
    padding: 0.85rem 0.25rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.8125rem;
  }

  .row dt {
    color: var(--ink-4);
  }

  .row dd {
    margin: 0;
    color: var(--ink);
    font-weight: 500;
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  @media (max-width: 460px) {
    .row {
      grid-template-columns: 130px 1fr;
      gap: 1rem;
      font-size: 0.75rem;
    }
  }
</style>
