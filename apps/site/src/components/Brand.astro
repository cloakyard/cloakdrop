---
import { site } from '../data/site';

/** Logo lockup: the scalable SVG mark + wordmark. Used in the header and footer. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 30, class: className } = Astro.props;
const wordmark = site.name.match(/^(.+?[a-z])([A-Z].*)$/);
const nameLead = wordmark?.[1] ?? site.name;
const nameAccent = wordmark?.[2] ?? '';
---

<a class:list={['brand', className]} href="/" aria-label={`${site.name} home`}>
  <img
    class="brand-mark"
    src="/cloakdrop-mark.svg"
    width={size}
    height={size}
    alt=""
    loading="eager"
    decoding="async"
  />
  <span class="brand-name" translate="no">{nameLead}<span class="brand-accent">{nameAccent}</span></span>
</a>

<style>
  .brand {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand-mark {
    flex: 0 0 auto;
    border-radius: 50%;
  }

  .brand-name {
    min-width: 0;
    overflow-wrap: anywhere;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-size: 1.125rem;
  }

  .brand-accent {
    color: var(--accent-ink);
  }
</style>
