---
import { features } from '../data/site';
import Icon from './Icon.astro';

const [lead, ...rest] = features;
// Decorative segment fills for the featured cell's mini-inspector (echoes the app).
const segFills = [92, 78, 84, 66, 71, 58, 62, 47];
---

<section id="features" class="section">
  <div class="container">
    <header class="head">
      <p class="eyebrow">Built for power users</p>
      <h2>Everything a download deserves.</h2>
      <p class="section-lead">
        From the first byte to a verified file, CloakDrop handles the whole journey —
        and stays out of your way while it does.
      </p>
    </header>

    <div class="bento">
      <!-- Featured cell -->
      <article class="surface-card feature feature--lead">
        <div class="feature-copy">
          <span class="icon-tile"><Icon name={lead.icon as any} size={24} /></span>
          <h3>{lead.title}</h3>
          <p>{lead.body}</p>
        </div>
        <div class="mini" aria-hidden="true">
          <div class="mini-head">
            <span>Segments</span><span>8 active</span>
          </div>
          {
            segFills.map((f, i) => (
              <div class="mini-row">
                <span class="mini-idx">#{i + 1}</span>
                <span class="mini-track"><i style={`width:${f}%`} /></span>
              </div>
            ))
          }
        </div>
      </article>

      {
        rest.map((f) => (
          <article class="surface-card feature">
            <span class="icon-tile"><Icon name={f.icon as any} size={22} /></span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    max-width: 60ch;
  }

  /* Balanced bento: two wide cells on top (featured + resume), four below. */
  .bento {
    margin-top: clamp(2.5rem, 5vw, 3.75rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .bento > :global(.feature:nth-child(2)) {
    grid-column: span 2;
  }

  .feature {
    padding: 1.7rem;
  }

  .feature h3 {
    margin: 1.1rem 0 0.5rem;
  }

  .feature p {
    color: var(--text-secondary);
    font-size: var(--step-0);
  }

  /* Featured cell spans two tracks and splits into copy + mini-inspector. */
  .feature--lead {
    grid-column: span 2;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: center;
    background:
      radial-gradient(90% 120% at 100% 0%, var(--accent-soft), transparent 60%),
      var(--surface);
  }

  .feature--lead h3 {
    font-size: var(--step-2);
  }

  .feature--lead .feature-copy p {
    font-size: var(--step-1);
    color: var(--text-secondary);
  }

  /* Mini segment inspector -------------------------------------------------- */
  .mini {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
    padding: 0.9rem 1rem;
    box-shadow: var(--shadow-sm);
  }

  .mini-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    font-weight: 560;
    color: var(--text-tertiary);
    margin-bottom: 0.65rem;
  }

  .mini-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0.32rem 0;
  }

  .mini-idx {
    font-size: 0.66rem;
    color: var(--text-tertiary);
    width: 1.4rem;
    font-variant-numeric: tabular-nums;
  }

  .mini-track {
    flex: 1;
    height: 6px;
    border-radius: 3px;
    background: var(--border);
    overflow: hidden;
  }

  .mini-track i {
    display: block;
    height: 100%;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
  }

  @media (max-width: 720px) {
    .feature--lead {
      grid-column: span 1;
      grid-template-columns: 1fr;
    }
  }
</style>
