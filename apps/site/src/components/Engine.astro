---
import { engine } from '../data/site';
import Kicker from './Kicker.astro';
---

<section id="engine" class="section engine" data-reveal>
  <div class="container">
    <Kicker num={engine.num} label={engine.label} />

    <div class="head">
      <h2>{engine.title}</h2>
      <p class="lead">{engine.lead}</p>
    </div>

    <div class="block">
      <div class="lead-row">
        <article class="lead-cell lead-cell--multi">
          <span class="n">{engine.lead1.n}</span>
          <div class="lead-copy">
            <h3>{engine.lead1.title}</h3>
            <p>{engine.lead1.body}</p>
          </div>
          <div class="mini" aria-hidden="true">
            <div class="mini-head"><span>SEGMENTS</span><span>8</span></div>
            {engine.segBars.map((w) => (
              <div class="mini-track"><i style={`width:${w}`} data-segw={w}></i></div>
            ))}
          </div>
        </article>

        <article class="lead-cell">
          <span class="n">{engine.lead2.n}</span>
          <h3>{engine.lead2.title}</h3>
          <p class="wide">{engine.lead2.body}</p>
        </article>
      </div>

      <div class="grid-row">
        {
          engine.grid.map((f) => (
            <article class="grid-cell">
              <span class="n">{f.n}</span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    margin-top: 1.4rem;
  }

  .head h2 {
    max-width: 12ch;
  }

  .head .lead {
    max-width: 34ch;
    flex: none;
    width: min(340px, 100%);
  }

  .block {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line-2);
  }

  .n {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-ink);
    margin-bottom: 1.1rem;
  }

  h3 {
    color: var(--ink);
  }

  .lead-cell p,
  .grid-cell p {
    color: var(--ink-3);
    margin-top: 0.6rem;
  }

  /* Two featured cells with a divider between --------------------------------- */
  .lead-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .lead-cell {
    padding: clamp(2rem, 4vw, 2.4rem) clamp(1.75rem, 3vw, 2.75rem) clamp(2rem, 4vw, 2.75rem) 0;
  }

  .lead-cell + .lead-cell {
    padding-inline: clamp(1.75rem, 3vw, 2.75rem) 0;
    border-left: 1px solid var(--line-2);
  }

  .lead-cell + .lead-cell {
    padding-left: clamp(1.75rem, 3vw, 2.75rem);
  }

  .lead-cell h3 {
    font-size: var(--t-h3-lg);
  }

  .lead-cell--multi {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'n n' 'copy mini';
    column-gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
  }

  .lead-cell--multi .n {
    grid-area: n;
  }
  .lead-copy {
    grid-area: copy;
  }
  .lead-cell--multi .mini {
    grid-area: mini;
  }

  .wide {
    max-width: 44ch;
  }

  /* Mini segment inspector ---------------------------------------------------- */
  .mini {
    width: 150px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.9rem;
    box-shadow: var(--shadow-card);
  }

  .mini-head {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--ink-4);
    margin-bottom: 0.7rem;
  }

  .mini-track {
    height: 5px;
    border-radius: 3px;
    background: var(--surface-2);
    overflow: hidden;
    margin-bottom: 0.45rem;
  }

  .mini-track:last-child {
    margin-bottom: 0;
  }

  .mini-track i {
    display: block;
    height: 100%;
    border-radius: 3px;
    background: var(--accent);
  }

  /* Four-up grid -------------------------------------------------------------- */
  .grid-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line-2);
  }

  .grid-cell {
    padding: clamp(1.75rem, 3vw, 2.2rem) clamp(1.1rem, 2vw, 1.75rem) clamp(2rem, 3vw, 2.5rem);
    padding-left: 0;
  }

  .grid-cell + .grid-cell {
    padding-left: clamp(1.1rem, 2vw, 1.75rem);
    border-left: 1px solid var(--line);
  }

  .grid-cell h3 {
    font-size: var(--t-h3);
  }

  .grid-cell p {
    font-size: 0.875rem;
  }

  @media (max-width: 860px) {
    .head {
      flex-direction: column;
      align-items: flex-start;
    }
    .head .lead {
      width: 100%;
    }
    .lead-row {
      grid-template-columns: 1fr;
    }
    .lead-cell,
    .lead-cell + .lead-cell {
      border-left: 0;
      padding-inline: 0;
      border-top: 1px solid var(--line);
    }
    .lead-cell:first-child {
      border-top: 0;
    }
    .grid-row {
      grid-template-columns: 1fr 1fr;
    }
    .grid-cell,
    .grid-cell + .grid-cell {
      border-left: 0;
      padding-inline: 0;
    }
    .grid-cell:nth-child(even) {
      padding-left: clamp(1.1rem, 3vw, 1.75rem);
      border-left: 1px solid var(--line);
    }
    .grid-cell:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 520px) {
    .lead-cell--multi {
      grid-template-columns: 1fr;
      grid-template-areas: 'n' 'copy' 'mini';
      row-gap: 1.25rem;
    }
    .lead-cell--multi .mini {
      width: 100%;
      max-width: 240px;
    }
    .grid-row {
      grid-template-columns: 1fr;
    }
    .grid-cell:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }
    .grid-cell + .grid-cell {
      border-top: 1px solid var(--line);
    }
  }
</style>
