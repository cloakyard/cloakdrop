---
import { site, hero } from '../data/site';
import Icon from './Icon.astro';

const titleLead = hero.titleLead.replace(/\n/g, ' ');
const titleAccent = hero.titleAccent.replace(/\n/g, ' ');
---

<section class="hero">
  <div class="container">
    <div class="top">
      <div class="lede">
        <p class="kicker">{hero.kicker}</p>
        <h1>{titleLead} <span class="accent">{titleAccent}</span></h1>
      </div>

      <div class="aside">
        <p class="lead">{hero.lead}</p>
        <div class="cta">
          <a class="btn btn--primary" href={site.releases} rel="noopener" data-magnetic>
            <Icon name="download" size={17} stroke={2} />
            Download for macOS
          </a>
          <a class="btn" href={site.repo} rel="noopener" data-magnetic>
            <Icon name="github" size={17} />
            View source
          </a>
        </div>
        <p class="micro">{hero.micro}</p>
      </div>
    </div>

    <figure class="shot">
      <figcaption class="fig">{hero.figLabel}</figcaption>

      <div class="aurora" aria-hidden="true"></div>

      <div class="scene">
        <div class="tilt" data-tilt>
          <picture>
            <source srcset="/hero.webp" type="image/webp" />
            <img
              src="/hero.png"
              width="2416"
              height="1578"
              alt={hero.shotAlt}
              fetchpriority="high"
              decoding="async"
            />
          </picture>
          <div class="glare" data-glare aria-hidden="true"></div>
          <div class="sheen-clip" aria-hidden="true">
            <div class="sheen" data-sheen></div>
          </div>
        </div>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .top {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: end;
  }

  .lede h1 {
    margin-top: 1.6rem;
    max-width: 12ch;
  }

  .aside {
    padding-bottom: 0.4rem;
  }

  .lead {
    max-width: 42ch;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .micro {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--ink-4);
  }

  /* Screenshot — transparent PNG/WebP with baked-in shadow on the page bg. */
  .shot {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    position: relative;
  }

  .fig {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--ink-4);
    margin-bottom: 0.5rem;
    position: relative;
    z-index: 3;
  }

  /* Ambient glow behind the screenshot. Sits under the image (z-index 0) and is
     never interactive. */
  .aurora {
    position: absolute;
    left: 50%;
    top: 52%;
    width: min(900px, 90%);
    height: 60%;
    transform: translate(-50%, -50%);
    z-index: 0;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--accent) 32%, transparent),
      transparent 62%
    );
    filter: blur(46px);
    animation: cd-aurora 14s ease-in-out infinite;
    pointer-events: none;
  }

  .scene {
    position: relative;
    z-index: 2;
    perspective: 1700px;
  }

  .tilt {
    position: relative;
    transform-style: preserve-3d;
    will-change: transform;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .shot img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* The screenshot has a baked-in shadow and transparent margins, so the glare
     and sheen are inset to land on the window itself rather than the padding. */
  .glare {
    position: absolute;
    inset: 5% 9%;
    border-radius: 14px;
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: overlay;
    transition: opacity 0.35s ease;
    background: radial-gradient(
      circle at 50% 40%,
      rgba(255, 255, 255, 0.28),
      transparent 42%
    );
  }

  .sheen-clip {
    position: absolute;
    inset: 5% 9%;
    border-radius: 14px;
    overflow: hidden;
    pointer-events: none;
  }

  .sheen {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 28%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.22),
      transparent
    );
    transform: translateX(-140%) skewX(-18deg);
  }

  @media (max-width: 820px) {
    .top {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      align-items: start;
    }
    .lede h1 {
      max-width: 16ch;
    }
    .lead {
      max-width: 52ch;
    }
  }
</style>
