---
import { resolve } from 'node:path';
import { site, hero, downloads } from '../data/site';
import { measureHero } from '../lib/heroGeometry';
import Icon from './Icon.astro';

const titleLead = hero.titleLead.replace(/\n/g, ' ');
const titleAccent = hero.titleAccent.replace(/\n/g, ' ');

// Measure the real screenshot at build time so its intrinsic dimensions and
// window geometry always stay in sync with the source asset. This also keeps
// the glare/sheen aligned if the screenshot is retaken or gains edge padding.
//
// Measure public/hero.png rather than repo-root /assets: it is the copy that
// actually ships (prebuild syncs it from /assets, the source of truth). Resolve
// it from the project root — import.meta.url points into the bundled chunk at
// build time, not at this file.
const shot = measureHero(resolve(process.cwd(), 'public/hero.png'));

// The overlays cover exactly the visible frame, so they inherit its rounding.
const winStyle = [
  `--win-top:${shot.insetTop.toFixed(3)}%`,
  `--win-right:${shot.insetRight.toFixed(3)}%`,
  `--win-bottom:${shot.insetBottom.toFixed(3)}%`,
  `--win-left:${shot.insetLeft.toFixed(3)}%`,
].join(';');
---

<section class="hero">
  <div class="container">
    <div class="top">
      <div class="lede">
        <p class="kicker">{hero.kicker}</p>
        <h1>{titleLead} <span class="accent">{titleAccent}</span></h1>
      </div>

      <div class="aside">
        <p class="lead">{hero.lead}</p>
        <div class="cta">
          <a class="btn btn--primary" href={downloads.sectionHref} data-magnetic>
            <Icon name="download" size={17} stroke={2} />
            {downloads.label}
          </a>
          <a class="btn" href="#product" data-magnetic>
            See it work
            <Icon name="arrow" size={17} />
          </a>
        </div>
        <p class="note">{downloads.note}</p>
        <p class="micro">
          {hero.micro} · <a href={site.repo} rel="noopener">View source</a>
        </p>
      </div>
    </div>

    <figure class="shot">
      <figcaption class="fig">{hero.figLabel}</figcaption>

      <div class="aurora" aria-hidden="true"></div>

      <div class="scene">
        <div class="tilt" data-tilt style={winStyle}>
          <div class="window-surface">
            <picture>
              <source srcset="/hero.webp" type="image/webp" />
              <img
                src="/hero.png"
                width={shot.width}
                height={shot.height}
                alt={hero.shotAlt}
                fetchpriority="high"
                decoding="async"
              />
            </picture>
            <div class="glare" data-glare aria-hidden="true"></div>
            <div class="sheen-clip" aria-hidden="true">
              <div class="sheen" data-sheen></div>
            </div>
          </div>
        </div>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .top {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .lede h1 {
    margin-top: 1.6rem;
    max-width: 12ch;
  }

  .aside {
    padding-top: 2rem;
  }

  .lead {
    max-width: 42ch;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  /* Beta caveat — what you'll find on the other side of the CTA, said up front. */
  .note {
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--ink-3);
  }

  .micro {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--ink-4);
  }

  .micro a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 0.2em;
  }

  /* The source stays shadow-free. Radius and depth are independent CSS controls. */
  .shot {
    --window-radius: clamp(11px, 3.05vw, 39px);
    --window-shadow-y: clamp(14px, 1.8vw, 23px);
    --window-shadow-blur: clamp(15px, 2vw, 25px);
    --window-shadow-color: rgba(18, 31, 38, 0.18);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    max-width: 72rem;
    margin-inline: auto;
    position: relative;
  }

  .fig {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--ink-4);
    margin-bottom: 0.5rem;
    position: relative;
    z-index: 3;
  }

  /* Ambient glow behind the screenshot. Sits under the image (z-index 0) and is
     never interactive. */
  .aurora {
    position: absolute;
    left: 50%;
    top: 52%;
    width: min(900px, 90%);
    height: 60%;
    transform: translate(-50%, -50%);
    z-index: 0;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--accent) 32%, transparent),
      transparent 62%
    );
    filter: blur(46px);
    animation: cd-aurora 14s ease-in-out infinite;
    pointer-events: none;
  }

  .scene {
    position: relative;
    z-index: 2;
    perspective: 1700px;
    overflow: visible;
  }

  .tilt {
    position: relative;
    isolation: isolate;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    transform-style: preserve-3d;
    will-change: transform;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* The screenshot's capture fringe is normalized in the source asset, so its
     native alpha edge can remain completely unclipped. */
  .window-surface {
    position: relative;
    overflow: visible;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    transform: translateZ(0);
  }

  /* <picture> is inline by default, which leaves a descender gap under the image
     and makes .tilt taller than what it wraps — enough to throw the percentage
     insets below off. Make it hug the image exactly. */
  .tilt picture {
    display: block;
    font-size: 0;
    filter: drop-shadow(
      0 var(--window-shadow-y) var(--window-shadow-blur) var(--window-shadow-color)
    );
  }

  .shot img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* These bounds are measured from the PNG at build time (see
     lib/heroGeometry.ts), keeping the overlays aligned with the rounded window
     even when the screenshot is replaced. */
  .glare {
    position: absolute;
    inset: var(--win-top) var(--win-right) var(--win-bottom) var(--win-left);
    border-radius: var(--window-radius);
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: overlay;
    transition: opacity 0.35s ease;
    background: radial-gradient(
      circle at 50% 40%,
      rgba(255, 255, 255, 0.28),
      transparent 42%
    );
  }

  .sheen-clip {
    position: absolute;
    inset: var(--win-top) var(--win-right) var(--win-bottom) var(--win-left);
    border-radius: var(--window-radius);
    overflow: hidden;
    pointer-events: none;
  }

  .sheen {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 28%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.22),
      transparent
    );
    transform: translateX(-140%) skewX(-18deg);
  }

  @media (max-width: 820px) {
    .shot {
      --window-shadow-y: 10px;
      --window-shadow-blur: 14px;
      --window-shadow-color: rgba(18, 31, 38, 0.14);
    }
    .top {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      align-items: start;
    }
    .aside {
      padding-top: 0;
    }
    .lede h1 {
      max-width: 16ch;
    }
    .lead {
      max-width: 52ch;
    }
    .scene {
      perspective: 1200px;
    }
    .glare,
    .sheen-clip {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding-top: 2.4rem;
    }
    .cta {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .cta .btn {
      min-height: 48px;
      padding-inline: 0.85rem;
    }
    .note,
    .micro {
      line-height: 1.65;
    }
    .shot {
      margin-top: 2rem;
    }
  }

  @media (max-width: 350px) {
    .cta {
      grid-template-columns: 1fr;
    }
    .cta .btn {
      justify-self: start;
    }
  }
</style>
