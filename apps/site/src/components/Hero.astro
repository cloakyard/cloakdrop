---
import { hero, downloads } from '../data/site';
import Icon from './Icon.astro';
import PixelFiles from './PixelFiles.astro';
---
<section class="hero frame" aria-labelledby="hero-title">
  <p class="eyebrow">A download manager, at home on your Mac.</p>
  <h1 id="hero-title">{hero.titleLead}<span>{hero.titleAccent}</span></h1>
  <p class="hero-lead">{hero.lead}</p>
  <PixelFiles />
  <div class="hero-actions">
    <a class="air-button air-button--primary" href={downloads.sectionHref}>
      <Icon name="download" size={18} />{downloads.label}
    </a>
    <a class="air-button air-button--quiet" href="#product">Explore features <Icon name="arrow" size={16} /></a>
  </div>
  <p class="availability">{downloads.note}<span>{hero.micro}</span></p>
</section>
