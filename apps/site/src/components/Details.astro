---
import { details } from '../data/site';
import Kicker from './Kicker.astro';
import Icon from './Icon.astro';
---

<section class="section details" data-reveal>
  <div class="container">
    <Kicker num={details.num} label={details.label} />

    <div class="head">
      <h2>{details.title}</h2>
      <p class="lead">{details.lead}</p>
    </div>

    <div class="grid">
      {
        details.items.map((d) => (
          <article class="cell">
            <span class="tile"><Icon name={d.icon as any} size={20} /></span>
            <h3>{d.title}</h3>
            <p>{d.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    margin-top: 1.4rem;
    margin-bottom: clamp(2rem, 4vw, 2.75rem);
  }

  .head h2 {
    max-width: 12ch;
  }

  .head .lead {
    width: min(360px, 100%);
    flex: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line-2);
    border-left: 1px solid var(--line-2);
  }

  .cell {
    padding: clamp(1.5rem, 3vw, 1.9rem);
    border-right: 1px solid var(--line-2);
    border-bottom: 1px solid var(--line-2);
  }

  .tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--tint);
    color: var(--accent-ink);
    margin-bottom: 1.1rem;
  }

  .cell h3 {
    font-size: 1.0625rem;
  }

  .cell p {
    margin-top: 0.5rem;
    color: var(--ink-3);
    font-size: 0.875rem;
  }

  @media (max-width: 820px) {
    .head {
      flex-direction: column;
      align-items: flex-start;
    }
    .head .lead {
      width: 100%;
    }
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .cell {
      padding: 1.15rem;
    }
    .tile {
      width: 34px;
      height: 34px;
      margin-bottom: 0.85rem;
    }
    .cell h3 {
      font-size: 0.96rem;
      line-height: 1.12;
    }
    .cell p {
      font-size: 0.78rem;
      line-height: 1.5;
    }
  }

  @media (max-width: 350px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
