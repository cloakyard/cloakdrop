---
import { details } from '../data/site';
import Kicker from './Kicker.astro';
import Icon from './Icon.astro';
---

<section class="section details" data-reveal>
  <div class="container">
    <header class="head">
      <div>
        <Kicker num={details.num} label={details.label} />
        <h2>{details.title}</h2>
      </div>
      <p class="lead">{details.lead}</p>
    </header>

    <div class="rail">
      {
        details.items.map((d, index) => (
          <article class="cell">
            <div class="cell-head">
              <span class="index">{String(index + 1).padStart(2, '0')}</span>
              <Icon name={d.icon} size={22} />
            </div>
            <h3>{d.title}</h3>
            <p>{d.body}</p>
            <ul class="meta" aria-label={`${d.title} highlights`}>
              {d.meta.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.55fr);
    justify-content: space-between;
    align-items: end;
    gap: clamp(2rem, 7vw, 7rem);
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .head h2 {
    max-width: 13ch;
    margin-top: 1.3rem;
  }

  .head .lead {
    max-width: 34ch;
    justify-self: end;
  }

  .rail {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line-2);
    border-bottom: 1px solid var(--line-2);
  }

  .cell {
    min-width: 0;
    padding: clamp(1.4rem, 2.8vw, 2.25rem);
    border-left: 1px solid var(--line-2);
  }

  .cell:last-child {
    border-right: 1px solid var(--line-2);
  }

  .cell-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--accent-ink);
    margin-bottom: clamp(2rem, 4vw, 3.8rem);
  }

  .index {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--ink-4);
  }

  .cell h3 {
    max-width: 13ch;
    font-size: clamp(1.05rem, 1.2vw, 1.28rem);
  }

  .cell p {
    margin-top: 0.75rem;
    color: var(--ink-3);
    font-size: 0.86rem;
    line-height: 1.62;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .meta li {
    padding: 0.34rem 0.52rem;
    color: var(--ink-3);
    background: color-mix(in srgb, var(--surface-2) 78%, transparent);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.025em;
    line-height: 1;
  }

  @media (max-width: 900px) {
    .head {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .head .lead {
      max-width: 42ch;
      justify-self: start;
    }
    .rail {
      grid-template-columns: 1fr 1fr;
    }
    .cell:nth-child(3),
    .cell:nth-child(4) {
      border-top: 1px solid var(--line-2);
    }
    .cell:nth-child(2) {
      border-right: 1px solid var(--line-2);
    }
  }

  @media (max-width: 520px) {
    .rail {
      grid-template-columns: 1fr;
    }
    .cell {
      display: grid;
      grid-template-columns: 2.6rem minmax(0, 1fr);
      gap: 0 0.9rem;
      padding: 1.35rem 0;
      border-left: 0;
      border-top: 1px solid var(--line-2);
    }
    .cell:first-child {
      border-top: 0;
    }
    .cell:nth-child(2),
    .cell:last-child {
      border-right: 0;
    }
    .cell-head {
      grid-row: 1 / span 2;
      display: grid;
      justify-items: center;
      align-content: start;
      gap: 0.65rem;
      margin: 0;
    }
    .cell h3,
    .cell p,
    .cell .meta {
      grid-column: 2;
    }
    .cell p {
      font-size: 0.84rem;
    }
    .rail {
      border-bottom: 1px solid var(--line-2);
    }
  }
</style>
