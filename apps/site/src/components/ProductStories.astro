---
import { product } from '../data/site';
import Kicker from './Kicker.astro';

const segmentLabels = ['01', '02', '03', '04', '05', '06', '07', '08'];
---

<section id="product" class="section product">
  <div class="container">
    <div class="intro" data-reveal>
      <Kicker num={product.num} label={product.label} />
      <div class="head">
        <h2>{product.title}</h2>
        <p class="lead">{product.lead}</p>
      </div>
    </div>

    <div class="experience" data-product-experience data-reveal>
      <div class="story-tabs" role="tablist" aria-label="Product workflow">
        {
          product.stories.map((story, index) => (
            <button
              id={`story-tab-${story.visual}`}
              class="story-tab"
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`story-panel-${story.visual}`}
              tabindex={index === 0 ? '0' : '-1'}
              data-story-tab={story.visual}
            >
              <span class="story-meta"><b>{story.n}</b> — {story.label}</span>
              <span class="story-title">{story.title}</span>
            </button>
          ))
        }
      </div>

      <div class="stage">
        {
          product.stories.map((story, index) => (
            <div
              id={`story-panel-${story.visual}`}
              class={`story-panel panel--${story.visual}`}
              role="tabpanel"
              aria-labelledby={`story-tab-${story.visual}`}
              data-story-panel={story.visual}
              hidden={index !== 0}
            >
              <header class="diagram-head">
                <span>{story.n} / {story.label}</span>
                <h3>{story.title}</h3>
                <p>{story.body}</p>
              </header>

              {story.visual === 'speed' && (
                <div
                  class="diagram diagram--speed"
                  role="img"
                  aria-label="One URL is planned into eight parallel byte ranges, written into one resumable part file, then verified as a complete file"
                >
                  <div class="node">
                    <small>INPUT</small>
                    <strong>One URL</strong>
                    <span>6.52 GB</span>
                  </div>
                  <i class="arrow" aria-hidden="true">→</i>
                  <div class="range-bank">
                    <small>TRANSFER</small>
                    <strong>8 byte ranges</strong>
                    <div aria-hidden="true">
                      {segmentLabels.map((label) => <span><b>{label}</b><i></i></span>)}
                    </div>
                  </div>
                  <i class="arrow" aria-hidden="true">→</i>
                  <div class="node">
                    <small>RESUME</small>
                    <strong>One .cdpart</strong>
                    <span>Exact byte state</span>
                  </div>
                  <i class="arrow" aria-hidden="true">→</i>
                  <div class="node node--accent">
                    <small>OUTPUT</small>
                    <strong>Verified file</strong>
                    <span>Byte-perfect</span>
                  </div>
                </div>
              )}

              {story.visual === 'capture' && (
                <div
                  class="diagram diagram--capture"
                  role="img"
                  aria-label="Pasted links, drag and share actions, and the built-in browser all pass through a local resolver into the same CloakDrop download engine"
                >
                  <div class="input-stack">
                    <small>WAYS IN</small>
                    <span>Paste a URL</span>
                    <span>Drag or Share</span>
                    <span>Built-in browser</span>
                  </div>
                  <div class="converge" aria-hidden="true"><i></i><b>→</b></div>
                  <div class="node">
                    <small>LOCAL</small>
                    <strong>Resolve the link</strong>
                    <span>Files, HLS, DASH, video</span>
                  </div>
                  <i class="arrow" aria-hidden="true">→</i>
                  <div class="node node--accent">
                    <small>ONE ENGINE</small>
                    <strong>Download privately</strong>
                    <span>No hand-off, no cloud</span>
                  </div>
                </div>
              )}

              {story.visual === 'organize' && (
                <div
                  class="diagram diagram--organize"
                  role="img"
                  aria-label="A completed file is checked once, then local rules route it to a queue and folder, detect duplicates, and verify its integrity"
                >
                  <div class="node node--source">
                    <small>EVENT</small>
                    <strong>Download completes</strong>
                    <span>One local hand-off</span>
                  </div>
                  <div class="branch" aria-hidden="true"><i></i><b>↓</b></div>
                  <div class="outcomes">
                    <div class="node">
                      <small>ROUTE</small>
                      <strong>Queue + folder</strong>
                      <span>Rules choose both</span>
                    </div>
                    <div class="node">
                      <small>GUARD</small>
                      <strong>Duplicate check</strong>
                      <span>No silent overwrite</span>
                    </div>
                    <div class="node node--accent">
                      <small>TRUST</small>
                      <strong>Verify + receipt</strong>
                      <span>Checksum recorded</span>
                    </div>
                  </div>
                </div>
              )}

              <div class="proof-row" aria-label={`${story.label} capabilities`}>
                {story.points.map((point, pointIndex) => (
                  <span><b>{String(pointIndex + 1).padStart(2, '0')}</b>{point}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    margin-top: 1.4rem;
  }

  .head h2 {
    max-width: 14ch;
  }

  .head .lead {
    width: min(390px, 100%);
    flex: none;
  }

  .experience {
    display: grid;
    grid-template-columns: minmax(220px, 0.58fr) minmax(0, 1.7fr);
    margin-top: clamp(2.5rem, 5vw, 3.75rem);
    overflow: hidden;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
  }

  .story-tabs {
    display: flex;
    flex-direction: column;
    padding: 0.7rem;
    border-right: 1px solid var(--line);
  }

  .story-tab {
    position: relative;
    width: 100%;
    padding: 1.15rem 1rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-3);
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition: color 0.18s ease, background 0.18s ease;
  }

  .story-tab::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--accent-ink);
    transform: scaleY(0);
    transition: transform 0.2s ease;
  }

  .story-tab:hover {
    color: var(--ink-2);
    background: var(--surface-2);
  }

  .story-tab[aria-selected='true'] {
    color: var(--ink);
    background: var(--surface);
  }

  .story-tab[aria-selected='true']::before {
    transform: scaleY(1);
  }

  .story-meta,
  .diagram-head > span,
  .node small,
  .range-bank > small,
  .input-stack > small {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .story-meta b {
    font-weight: 600;
  }

  .story-title {
    display: block;
    margin-top: 0.42rem;
    font-size: clamp(0.98rem, 0.94rem + 0.2vw, 1.1rem);
    font-weight: 750;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .stage {
    position: relative;
    min-height: clamp(580px, 46vw, 620px);
    background-color: var(--surface-2);
    background-image: radial-gradient(circle, var(--line-2) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .story-panel {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: clamp(1.25rem, 2.8vw, 2rem);
    padding: clamp(1.35rem, 3vw, 2.6rem);
    animation: story-in 0.32s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .story-panel[hidden] {
    display: none;
  }

  .diagram-head {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(280px, 1.2fr);
    gap: 0.55rem clamp(1.5rem, 4vw, 3rem);
    align-items: end;
  }

  .diagram-head > span {
    grid-column: 1 / -1;
  }

  .diagram-head h3 {
    color: var(--ink);
    font-size: clamp(1.45rem, 1.2rem + 1vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .diagram-head p {
    max-width: 58ch;
    color: var(--ink-3);
    line-height: 1.55;
  }

  .diagram {
    align-self: stretch;
    display: grid;
    align-items: center;
    gap: clamp(0.55rem, 1.5vw, 1rem);
    min-height: 230px;
    padding: clamp(1rem, 2vw, 1.5rem);
    border: 1px solid var(--line-2);
    border-radius: 18px;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
  }

  .diagram--speed {
    grid-template-columns: minmax(105px, 0.8fr) auto minmax(160px, 1.25fr) auto minmax(120px, 0.9fr) auto minmax(120px, 0.9fr);
  }

  .diagram--capture {
    grid-template-columns: minmax(150px, 1.05fr) minmax(48px, 0.35fr) minmax(150px, 1fr) auto minmax(150px, 1fr);
  }

  .diagram--organize {
    grid-template-columns: minmax(0, 1fr);
  }

  .node,
  .range-bank,
  .input-stack {
    display: grid;
    align-content: center;
    gap: 0.38rem;
    min-height: 112px;
    padding: 1rem;
    border: 1px solid var(--line-2);
    border-radius: 14px;
    background: var(--surface);
  }

  .node strong,
  .range-bank strong {
    color: var(--ink);
    font-size: 0.92rem;
  }

  .node > span {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--ink-4);
  }

  .node--accent {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
    background: var(--accent-soft);
  }

  .arrow {
    color: var(--accent-ink);
    font-size: 1.2rem;
    font-style: normal;
    text-align: center;
  }

  .range-bank > div {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .range-bank > div span {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.25rem;
  }

  .range-bank > div b {
    font-family: var(--font-mono);
    font-size: 0.52rem;
    font-weight: 500;
    color: var(--ink-4);
  }

  .range-bank > div i {
    height: 3px;
    border-radius: 2px;
    background: var(--accent);
  }

  .input-stack {
    gap: 0.42rem;
  }

  .input-stack span {
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink-2);
    background: var(--surface-2);
    font-size: 0.74rem;
    font-weight: 650;
  }

  .converge {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 112px;
    color: var(--accent-ink);
  }

  .converge i {
    width: 100%;
    height: 1px;
    background: var(--line-2);
  }

  .converge b {
    position: relative;
    margin-left: -0.2rem;
    font-size: 1.2rem;
    background: var(--surface);
  }

  .node--source {
    width: min(260px, 100%);
    min-height: 96px;
    margin-inline: auto;
  }

  .branch {
    position: relative;
    display: grid;
    place-items: center;
    height: 28px;
    color: var(--accent-ink);
  }

  .branch i {
    position: absolute;
    top: 0;
    width: min(68%, 540px);
    height: 16px;
    border-left: 1px solid var(--line-2);
    border-right: 1px solid var(--line-2);
    border-top: 1px solid var(--line-2);
  }

  .branch b {
    position: relative;
    padding-inline: 0.4rem;
    background: var(--surface);
  }

  .outcomes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.65rem, 1.5vw, 1rem);
  }

  .outcomes .node {
    min-height: 98px;
  }

  .proof-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line-2);
  }

  .proof-row span {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.55rem;
    color: var(--ink-3);
    font-size: 0.76rem;
  }

  .proof-row b {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    color: var(--accent-ink);
  }

  @keyframes story-in {
    from {
      opacity: 0;
      transform: translateY(7px);
    }
  }

  @media (max-width: 980px) {
    .experience {
      grid-template-columns: 1fr;
    }
    .story-tabs {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      padding: 0.55rem;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .story-tab {
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .story-tab:last-child {
      border-right: 0;
    }
    .story-tab::before {
      inset: auto 0 0;
      width: auto;
      height: 2px;
      transform: scaleX(0);
    }
    .story-tab[aria-selected='true']::before {
      transform: scaleX(1);
    }
    .stage {
      min-height: 610px;
    }
  }

  @media (max-width: 720px) {
    .head {
      flex-direction: column;
      align-items: flex-start;
    }
    .head .lead {
      width: 100%;
    }
    .story-tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .story-tab {
      min-width: 0;
      padding: 0.85rem 0.65rem;
    }
    .story-title {
      font-size: 0.9rem;
    }
    .stage {
      min-height: 760px;
    }
    .story-panel {
      gap: 1.1rem;
      padding: 1.1rem;
    }
    .diagram-head {
      grid-template-columns: 1fr;
    }
    .diagram-head h3,
    .diagram-head p {
      grid-column: 1;
    }
    .diagram {
      min-height: 390px;
    }
    .diagram--speed,
    .diagram--capture {
      grid-template-columns: 1fr;
    }
    .diagram--speed .arrow,
    .diagram--capture > .arrow {
      transform: rotate(90deg);
    }
    .diagram--capture .converge {
      min-height: 32px;
      transform: rotate(90deg);
    }
    .node,
    .range-bank,
    .input-stack {
      min-height: 82px;
    }
    .outcomes {
      grid-template-columns: 1fr;
    }
    .branch i {
      display: none;
    }
    .proof-row {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }
  }

  @media (max-width: 420px) {
    .stage {
      min-height: 820px;
    }
    .story-meta {
      font-size: 0.58rem;
    }
    .story-title {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-panel {
      animation: none;
    }
  }
</style>
