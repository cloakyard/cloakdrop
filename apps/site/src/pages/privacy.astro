---
import { Content as PrivacyDocument, getHeadings } from '../../../../PRIVACY.md';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
const headings = getHeadings().filter((heading) => heading.depth === 2);
---
<BaseLayout title={`Privacy policy — ${site.name}`} description="How CloakDrop stores local data, when its macOS app connects to the network, and the privacy controls available to you.">
  <Header linkPrefix="/" />
  <main id="main" class="policy-page frame" tabindex="-1">
    <header class="policy-intro">
      <p class="eyebrow">CloakDrop · Privacy</p>
      <h1>Privacy policy.</h1>
      <p class="policy-lead">App state stays on your Mac. Network requests happen for transfers and features you initiate or configure.</p>
      <p class="policy-date">Last updated <time datetime="2026-09-06">September 6, 2026</time></p>
    </header>
    <div class="policy-layout">
      <details class="policy-contents" open>
        <summary>On this page</summary>
        <nav aria-label="Policy contents">
          {headings.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
        </nav>
      </details>
      <article class="policy-document" aria-label="CloakDrop app privacy policy"><PrivacyDocument /></article>
    </div>
  </main>
  <Footer />
</BaseLayout>
