---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Page not found — CloakDrop" description="The requested CloakDrop page does not exist." noindex>
  <Header linkPrefix="/" />
  <main id="main" class="not-found frame" tabindex="-1">
    <div>
      <p class="eyebrow">404 · Page not found</p>
      <h1>This link went missing.</h1>
      <p>The page may have moved or never existed. Return to CloakDrop to find the app, source code, and available downloads.</p>
      <a class="air-button air-button--primary" href="/">Back to CloakDrop <Icon name="arrow" size={16} /></a>
    </div>
  </main>
  <Footer />
</BaseLayout>
