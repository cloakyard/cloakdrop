---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SpecStrip from '../components/SpecStrip.astro';
import Engine from '../components/Engine.astro';
import Provenance from '../components/Provenance.astro';
import Capture from '../components/Capture.astro';
import Details from '../components/Details.astro';
import Privacy from '../components/Privacy.astro';
import UnderTheHood from '../components/UnderTheHood.astro';
import Suite from '../components/Suite.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main id="main">
    <Hero />
    <SpecStrip />
    <Engine />
    <Provenance />
    <Capture />
    <Details />
    <Privacy />
    <UnderTheHood />
    <Suite />
  </main>
  <Footer />
</BaseLayout>
