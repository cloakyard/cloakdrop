---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SpecStrip from '../components/SpecStrip.astro';
import ProductStories from '../components/ProductStories.astro';
import Provenance from '../components/Provenance.astro';
import Details from '../components/Details.astro';
import Privacy from '../components/Privacy.astro';
import Download from '../components/Download.astro';
import UnderTheHood from '../components/UnderTheHood.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main id="main">
    <Hero />
    <SpecStrip />
    <ProductStories />
    <Provenance />
    <Details />
    <Privacy />
    <Download />
    <UnderTheHood />
  </main>
  <Footer />
</BaseLayout>
