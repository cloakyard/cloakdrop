    "Read this page with the bundled resolver (YouTube and 1800+ sites) and pick a quality": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee esta página con el resolutor integrado (YouTube y más de 1800 sitios) y elige una calidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysez cette page avec le résolveur intégré (YouTube et plus de 1800 sites) et choisissez une qualité"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite mit dem integrierten Resolver (YouTube und 1800+ Seiten) lesen und eine Qualität wählen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用内置解析器（YouTube 及 1800 多个网站）读取此页面并选择画质"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵のリゾルバ（YouTube と 1800 以上のサイト）でこのページを解析し、画質を選択"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장 리졸버(YouTube 및 1800개 이상 사이트)로 이 페이지를 읽고 화질을 선택하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia esta página com o resolvedor integrado (YouTube e mais de 1800 sites) e escolha uma qualidade"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитать эту страницу встроенным резолвером (YouTube и 1800+ сайтов) и выбрать качество"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقرأ هذه الصفحة باستخدام المحلّل المدمج (يوتيوب و1800+ موقع) واختر الجودة"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस पेज को अंतर्निहित रिज़ॉल्वर (YouTube और 1800+ साइटें) से पढ़ें और गुणवत्ता चुनें"
          }
        }
      }
    },
    "Reading the video timed out. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة قراءة الفيديو. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung beim Lesen des Videos. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo al leer el vídeo. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai dépassé lors de l’analyse de la vidéo. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वीडियो पढ़ने का समय समाप्त हो गया। पुनः प्रयास करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の読み込みがタイムアウトしました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상 읽기 시간이 초과되었습니다. 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo esgotado ao ler o vídeo. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время ожидания чтения видео истекло. Повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取视频超时。请重试。"
          }
        }
      }
    },
