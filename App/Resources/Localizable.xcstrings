        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 1테라바이트. 인터넷 사업자들이 당신의 이름을 속삭입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
