    "Route downloads into folders or queues by URL, type, or size — all on your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وجّه التنزيلات إلى مجلدات أو قوائم انتظار حسب الرابط أو النوع أو الحجم — كل ذلك على جهاز Mac الخاص بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leite Downloads nach URL, Typ oder Größe in Ordner oder Warteschlangen – alles auf deinem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enruta las descargas a carpetas o colas según URL, tipo o tamaño, todo en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acheminez les téléchargements vers des dossiers ou files selon l’URL, le type ou la taille — tout sur votre Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "URL, प्रकार या आकार के अनुसार डाउनलोड को फ़ोल्डर या क़तार में भेजें — सब आपके Mac पर।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URL・種類・サイズに応じて、ダウンロードをフォルダやキューに振り分け。すべてあなたのMac上で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "URL, 유형 또는 크기에 따라 다운로드를 폴더나 대기열로 분류 — 모두 사용자의 Mac에서."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaminhe downloads para pastas ou filas por URL, tipo ou tamanho — tudo no seu Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распределяйте загрузки по папкам или очередям на основе URL, типа или размера — всё на вашем Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 URL、类型或大小将下载分流到文件夹或队列——全部在你的 Mac 上。"
          }
        }
      }
    },
