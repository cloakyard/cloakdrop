    "“%@” is already in your downloads. Download it again?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ya está en tus descargas. ¿Descargarlo de nuevo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est déjà dans vos téléchargements. Le télécharger à nouveau ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist bereits in deinen Downloads. Erneut laden?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已在你的下载列表中。要重新下载吗？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” はすでにダウンロードにあります。もう一度ダウンロードしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”이(가) 이미 다운로드에 있습니다. 다시 다운로드하시겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” já está nos seus downloads. Baixar novamente?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» уже есть в загрузках. Скачать снова?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” موجود بالفعل في تنزيلاتك. هل تريد تنزيله مرة أخرى؟"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” पहले से आपके डाउनलोड में है। इसे फिर से डाउनलोड करें?"
          }
        }
      }
    },
    "“%@” will be permanently deleted. This can’t be undone.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” se eliminará permanentemente. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » sera définitivement supprimé. Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wird endgültig gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”将被永久删除。此操作无法撤销。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” は完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”이(가) 영구적으로 삭제됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” será apagado permanentemente. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» будет удалён безвозвратно. Это действие нельзя отменить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف ”%@“ نهائيًا. لا يمكن التراجع عن ذلك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” स्थायी रूप से मिटा दी जाएगी। इसे पूर्ववत नहीं किया जा सकता।"
          }
        }
      }
    },
    "“%@” — same name and size — is already in your downloads. Download it again?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» —mismo nombre y tamaño— ya está en tus descargas. ¿Descargarlo de nuevo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » — même nom et même taille — est déjà dans vos téléchargements. Le télécharger à nouveau ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ – gleicher Name und gleiche Größe – ist bereits in deinen Downloads. Erneut laden?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”（名称和大小相同）已在你的下载中。要再次下载吗？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」（名前とサイズが同じ）はすでにダウンロードにあります。もう一度ダウンロードしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” — 이름과 크기가 동일 — 이(가) 이미 다운로드에 있습니다. 다시 다운로드하시겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” — mesmo nome e tamanho — já está nos seus downloads. Baixar novamente?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — то же имя и размер — уже есть в загрузках. Загрузить снова?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — بالاسم والحجم نفسه — موجود بالفعل في تنزيلاتك. هل تريد تنزيله مجددًا؟"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” — वही नाम और आकार — पहले से आपके डाउनलोड में है। दोबारा डाउनलोड करें?"
          }
        }
      }
    }
  },
  "version": "1.0"
}
