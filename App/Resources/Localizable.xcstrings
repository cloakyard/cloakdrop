    "%lld files will be permanently deleted. This can’t be undone.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán permanentemente %lld archivos. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichiers seront définitivement supprimés. Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Dateien werden endgültig gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个文件将被永久删除。此操作无法撤销。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個のファイルが完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개의 파일이 영구적으로 삭제됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld arquivos serão apagados permanentemente. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld файлов будут удалены безвозвратно. Это действие нельзя отменить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف %lld ملفات نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld फ़ाइलें स्थायी रूप से हटा दी जाएँगी। इसे पूर्ववत नहीं किया जा सकता।"
          }
        }
      }
    },
