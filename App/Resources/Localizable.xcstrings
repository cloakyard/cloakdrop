    "Counted and stored only on this Mac — never uploaded anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحتسب ويُخزَّن على هذا الـ Mac فقط — ولا يُرفع إلى أي مكان أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur auf diesem Mac gezählt und gespeichert – niemals irgendwohin hochgeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cuenta y se guarda solo en este Mac; nunca se sube a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptabilisé et stocké uniquement sur ce Mac — jamais envoyé où que ce soit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे केवल इसी Mac पर गिना और संग्रहीत किया जाता है — कहीं भी अपलोड नहीं किया जाता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac 上でのみ集計・保存され、どこにもアップロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서만 집계·저장되며, 어디에도 업로드되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contabilizado e armazenado apenas neste Mac — nunca enviado para lugar algum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсчитывается и хранится только на этом Mac — никуда не отправляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在这台 Mac 上统计和存储，绝不上传到任何地方。"
          }
        }
      }
    },
