    "Paste URLs — one per line. Patterns like `file[01-50].zip` expand automatically.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega las URL, una por línea. Los patrones como `file[01-50].zip` se expanden automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez des URL — une par ligne. Les motifs comme `file[01-50].zip` sont développés automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "URLs einfügen – eine pro Zeile. Muster wie `file[01-50].zip` werden automatisch erweitert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴 URL，每行一个。诸如 `file[01-50].zip` 的模式会自动展开。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URL を 1 行に 1 つずつ貼り付けてください。`file[01-50].zip` のようなパターンは自動的に展開されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "URL을 한 줄에 하나씩 붙여넣으세요. `file[01-50].zip` 같은 패턴은 자동으로 확장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole URLs — uma por linha. Padrões como `file[01-50].zip` se expandem automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте URL — по одному в строке. Шаблоны вроде `file[01-50].zip` раскрываются автоматически."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق عناوين URL — عنوانًا واحدًا في كل سطر. تتوسّع الأنماط مثل `file[01-50].zip` تلقائيًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "URL पेस्ट करें — हर पंक्ति में एक। `file[01-50].zip` जैसे पैटर्न स्वतः विस्तृत हो जाते हैं।"
          }
        }
      }
    },
