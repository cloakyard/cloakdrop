    "Measures your connection's real download, upload, and latency.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقيس سرعة التنزيل والرفع الفعلية وزمن الاستجابة لاتصالك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Misst die tatsächliche Download- und Upload-Geschwindigkeit sowie die Latenz deiner Verbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide la velocidad real de descarga y subida y la latencia de tu conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure le débit descendant et montant réels et la latence de votre connexion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कनेक्शन की वास्तविक डाउनलोड, अपलोड गति और लेटेंसी मापता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続の実際のダウンロード速度、アップロード速度、レイテンシを測定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결의 실제 다운로드·업로드 속도와 지연 시간을 측정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mede o download, o upload e a latência reais da sua conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измеряет реальную скорость загрузки и отдачи, а также задержку вашего подключения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量你的连接的实际下载、上传速度和延迟。"
          }
        }
      }
    },
