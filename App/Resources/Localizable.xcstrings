    "Add a URL to start downloading. CloakDrop splits files into parallel streams for speed.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una URL para empezar a descargar. CloakDrop divide los archivos en flujos paralelos para mayor velocidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une URL pour commencer le téléchargement. CloakDrop divise les fichiers en flux parallèles pour plus de rapidité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine URL hinzu, um den Download zu starten. CloakDrop teilt Dateien für mehr Geschwindigkeit in parallele Streams auf."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 URL 即可开始下载。CloakDrop 会将文件拆分为多个并行流以提升速度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URL を追加してダウンロードを開始しましょう。CloakDrop はファイルを複数のストリームに分割して高速化します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "URL을 추가하여 다운로드를 시작하세요. CloakDrop은 속도를 위해 파일을 병렬 스트림으로 분할합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma URL para começar a baixar. O CloakDrop divide os arquivos em fluxos paralelos para mais velocidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте URL, чтобы начать загрузку. CloakDrop разбивает файлы на параллельные потоки для ускорения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف عنوان URL لبدء التنزيل. يقسّم CloakDrop الملفات إلى تدفقات متوازية لزيادة السرعة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड शुरू करने के लिए कोई URL जोड़ें। CloakDrop गति के लिए फ़ाइलों को समानांतर स्ट्रीम में बाँटता है।"
          }
        }
      }
    },
