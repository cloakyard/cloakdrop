    "Installs a small on-device connector so these browsers can hand downloads to CloakDrop.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala un pequeño conector local para que estos navegadores puedan enviar descargas a CloakDrop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe un petit connecteur local pour que ces navigateurs puissent transmettre les téléchargements à CloakDrop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert einen kleinen lokalen Connector, damit diese Browser Downloads an CloakDrop übergeben können."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装一个本地小型连接器，让这些浏览器可以将下载任务交给 CloakDrop。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのブラウザがダウンロードを CloakDrop に渡せるよう、デバイス上に小さなコネクタをインストールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 브라우저들이 다운로드를 CloakDrop에 넘길 수 있도록 기기에 작은 커넥터를 설치합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala um pequeno conector local para que esses navegadores possam entregar downloads ao CloakDrop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливает небольшой локальный коннектор, чтобы эти браузеры могли передавать загрузки в CloakDrop."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يثبّت موصلاً صغيراً على الجهاز حتى تتمكّن هذه المتصفحات من تمرير التنزيلات إلى CloakDrop."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक छोटा ऑन-डिवाइस कनेक्टर इंस्टॉल करता है ताकि ये ब्राउज़र डाउनलोड CloakDrop को सौंप सकें।"
          }
        }
      }
    },
