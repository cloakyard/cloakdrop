    "Files download in parallel segments. More connections can be faster on high-latency links.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنزَّل الملفات في مقاطع متوازية. قد يكون عدد أكبر من الاتصالات أسرع على الروابط ذات زمن الاستجابة العالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien werden in parallelen Segmenten geladen. Mehr Verbindungen können bei Verbindungen mit hoher Latenz schneller sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos se descargan en segmentos paralelos. Más conexiones pueden ser más rápidas en enlaces de alta latencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sont téléchargés en segments parallèles. Davantage de connexions peuvent être plus rapides sur les liens à latence élevée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें समानांतर खंडों में डाउनलोड होती हैं। उच्च-लेटेंसी लिंक पर अधिक कनेक्शन तेज़ हो सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは複数のセグメントに分割して並列でダウンロードされます。遅延の大きい回線では、接続数を増やすと高速になる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 병렬 세그먼트로 다운로드됩니다. 지연 시간이 긴 회선에서는 연결 수가 많을수록 빠를 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos são baixados em segmentos paralelos. Mais conexões podem ser mais rápidas em links de alta latência."
          }
        },
