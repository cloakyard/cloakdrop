    "That is the complete list. There are no update pings, no analytics beacons, and no phone-home of any kind.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه هي القائمة الكاملة. لا توجد نبضات تحديث، ولا منارات تحليلات، ولا أي إرسال خفي من أي نوع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist die vollständige Liste. Es gibt keine Update-Pings, keine Analyse-Beacons und kein Nachhausetelefonieren jeglicher Art."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa es la lista completa. No hay pings de actualización, ni balizas de analítica, ni ningún tipo de comunicación con servidores propios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est la liste complète. Il n’y a aucun ping de mise à jour, aucune balise d’analyse, ni aucune communication cachée d’aucune sorte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यही पूरी सूची है। कोई अपडेट पिंग नहीं, कोई एनालिटिक्स बीकन नहीं, और किसी भी प्रकार का फ़ोन-होम नहीं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これが全リストです。アップデートの ping も、分析用のビーコンも、いかなる形の外部送信もありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것이 전체 목록입니다. 업데이트 핑도, 분석용 비콘도, 어떤 형태의 외부 전송도 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa é a lista completa. Não há pings de atualização, nem beacons de análise, nem qualquer tipo de comunicação oculta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это полный список. Никаких пингов обновлений, аналитических маяков и какой-либо отправки данных на сторону."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这就是完整清单。没有更新探测、没有分析信标，也没有任何形式的回传。"
          }
        }
      }
    },
