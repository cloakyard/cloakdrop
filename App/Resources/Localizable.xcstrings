    "You already downloaded “%@” from this server. Download it again?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya descargaste «%@» desde este servidor. ¿Descargarlo de nuevo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà téléchargé « %@ » depuis ce serveur. Le télécharger à nouveau ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wurde bereits von diesem Server geladen. Erneut laden?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已从此服务器下载过“%@”。要再次下载吗？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はこのサーバーからすでにダウンロード済みです。もう一度ダウンロードしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버에서 “%@”을(를) 이미 다운로드했습니다. 다시 다운로드하시겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já baixou “%@” deste servidor. Baixar novamente?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уже загрузили «%@» с этого сервера. Загрузить снова?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد نزّلت «%@» من هذا الخادم من قبل. هل تريد تنزيله مجددًا؟"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इस सर्वर से “%@” पहले ही डाउनलोड कर चुके हैं। दोबारा डाउनलोड करें?"
          }
        }
      }
    },
    "You’ll grant access to each browser’s folder, then add the CloakDrop extension. Everything stays on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Darás acceso a la carpeta de cada navegador y luego añadirás la extensión de CloakDrop. Todo permanece en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous autoriserez l’accès au dossier de chaque navigateur, puis ajouterez l’extension CloakDrop. Tout reste sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gewährst Zugriff auf den Ordner jedes Browsers und fügst dann die CloakDrop-Erweiterung hinzu. Alles bleibt auf diesem Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你需要授予每个浏览器文件夹的访问权限，然后添加 CloakDrop 扩展。所有内容都保留在这台 Mac 上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ブラウザのフォルダへのアクセスを許可し、CloakDrop 拡張機能を追加します。すべてはこの Mac に留まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 브라우저의 폴더에 대한 접근을 허용한 다음 CloakDrop 확장 프로그램을 추가합니다. 모든 것은 이 Mac에 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você concederá acesso à pasta de cada navegador e depois adicionará a extensão do CloakDrop. Tudo permanece neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы предоставите доступ к папке каждого браузера, затем добавите расширение CloakDrop. Всё остаётся на этом Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستمنح الوصول إلى مجلد كل متصفح، ثم تضيف امتداد CloakDrop. يبقى كل شيء على هذا الـ Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप हर ब्राउज़र के फ़ोल्डर तक पहुँच देंगे, फिर CloakDrop एक्सटेंशन जोड़ेंगे। सब कुछ इसी Mac पर रहता है।"
          }
        }
      }
    },
