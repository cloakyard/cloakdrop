    "Paste links — one per line. Patterns like `file[01-50].zip` expand automatically.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق الروابط — رابطًا واحدًا في كل سطر. تُوسَّع الأنماط مثل `file[01-50].zip` تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links einfügen – einen pro Zeile. Muster wie `file[01-50].zip` werden automatisch erweitert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega enlaces, uno por línea. Los patrones como `file[01-50].zip` se expanden automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez des liens, un par ligne. Les motifs comme `file[01-50].zip` sont développés automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक चिपकाएँ — प्रति पंक्ति एक। `file[01-50].zip` जैसे पैटर्न स्वतः विस्तृत हो जाते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを 1 行に 1 つずつ貼り付けます。`file[01-50].zip` のようなパターンは自動的に展開されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 한 줄에 하나씩 붙여넣으세요. `file[01-50].zip` 같은 패턴은 자동으로 확장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole links — um por linha. Padrões como `file[01-50].zip` são expandidos automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте ссылки — по одной в строке. Шаблоны вроде `file[01-50].zip` разворачиваются автоматически."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴链接，每行一个。`file[01-50].zip` 之类的模式会自动展开。"
          }
        }
      }
    },
