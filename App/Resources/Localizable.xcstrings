    "Also checks a checksum the site publishes next to the download on the same server (.sha256/.sha1/.md5).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحقق أيضًا من مجموع اختباري ينشره الموقع بجوار التنزيل على الخادم نفسه (.sha256/.sha1/.md5)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft außerdem eine Prüfsumme, die die Website neben dem Download auf demselben Server bereitstellt (.sha256/.sha1/.md5)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También comprueba una suma de comprobación que el sitio publica junto a la descarga en el mismo servidor (.sha256/.sha1/.md5)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie aussi une somme de contrôle que le site publie à côté du téléchargement, sur le même serveur (.sha256/.sha1/.md5)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइट द्वारा उसी सर्वर पर डाउनलोड के साथ प्रकाशित चेकसम की भी जाँच करता है (.sha256/.sha1/.md5)।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイトが同じサーバー上でダウンロードの隣に公開しているチェックサム（.sha256/.sha1/.md5）も確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이트가 같은 서버의 다운로드 옆에 게시한 체크섬(.sha256/.sha1/.md5)도 확인합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também verifica um checksum que o site publica ao lado do download no mesmo servidor (.sha256/.sha1/.md5)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также проверяет контрольную сумму, которую сайт публикует рядом с загрузкой на том же сервере (.sha256/.sha1/.md5)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还会检查站点在同一服务器上随下载一起发布的校验和（.sha256/.sha1/.md5）。"
          }
        }
      }
    },
    "Applies across all active downloads combined.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطبَّق على جميع التنزيلات النشطة مجتمعةً."
