    },
    "Rules apply top to bottom — the first match wins.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas se aplican de arriba abajo: gana la primera coincidencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles s’appliquent de haut en bas — la première correspondance l’emporte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln gelten von oben nach unten – der erste Treffer gewinnt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则自上而下应用——以第一个匹配为准。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールは上から順に適用され、最初に一致したものが優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙은 위에서 아래로 적용되며, 처음 일치하는 규칙이 우선합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras se aplicam de cima para baixo — a primeira correspondência vence."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила применяются сверху вниз — побеждает первое совпадение."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُطبَّق القواعد من الأعلى إلى الأسفل — وتفوز أول مطابقة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियम ऊपर से नीचे लागू होते हैं — पहला मिलान मान्य होता है।"
          }
        }
      }
    },
    "Rules automatically route downloads by URL, type, or size — into a folder or queue, at a set speed. Everything is evaluated on your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas enrutan las descargas automáticamente por URL, tipo o tamaño: a una carpeta o cola, con una velocidad definida. Todo se evalúa en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles acheminent automatiquement les téléchargements selon l’URL, le type ou la taille — vers un dossier ou une file, à une vitesse définie. Tout est évalué sur votre Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln leiten Downloads automatisch nach URL, Typ oder Größe – in einen Ordner oder eine Warteschlange, mit festgelegtem Tempo. Alles wird auf deinem Mac ausgewertet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则会按 URL、类型或大小自动将下载分流到文件夹或队列，并以设定的速度进行。一切都在你的 Mac 上评估。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールはURL・種類・サイズに応じて、ダウンロードをフォルダやキューへ、設定した速度で自動的に振り分けます。すべてあなたのMac上で評価されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙은 URL, 유형 또는 크기에 따라 다운로드를 폴더나 대기열로, 설정한 속도로 자동 분류합니다. 모든 것은 사용자의 Mac에서 평가됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras encaminham downloads automaticamente por URL, tipo ou tamanho — para uma pasta ou fila, a uma velocidade definida. Tudo é avaliado no seu Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила автоматически распределяют загрузки по URL, типу или размеру — в папку или очередь, с заданной скоростью. Всё вычисляется на вашем Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توجّه القواعد التنزيلات تلقائيًا حسب الرابط أو النوع أو الحجم — إلى مجلد أو قائمة انتظار، وبسرعة محددة. كل ذلك يُقيَّم على جهاز Mac الخاص بك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियम डाउनलोड को URL, प्रकार या आकार के अनुसार अपने-आप किसी फ़ोल्डर या क़तार में, निर्धारित गति पर भेजते हैं। सब कुछ आपके Mac पर मूल्यांकित होता है।"
          }
        }
      }
    },
