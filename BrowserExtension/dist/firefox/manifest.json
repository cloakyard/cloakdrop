{
  "manifest_version": 3,
  "name": "CloakDrop",
  "version": "1.0",
  "description": "Send links and media to CloakDrop — a private, on-device, multi-segment download manager.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cloakdrop@cloakyard.com",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "background": {
    "scripts": ["media.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["media.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "contextMenus",
    "cookies",
    "activeTab",
    "tabs",
    "scripting",
    "webRequest",
    "nativeMessaging",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_title": "CloakDrop",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon-48.png",
      "96": "icon-96.png"
    }
  }
}
